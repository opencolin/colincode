#!/usr/bin/env bash
# colincode — a coding agent in a tenki.cloud box, one command away.
#
#   colin                   pick an agent (or make one) and jump into it
#   colin claude            Claude Code; colin codex / colin opencode likewise
#   colin <agent-name>      a specific agent you created
#
# An "agent" is a name + harness (claude|codex|opencode) + inference provider
# (+ model). Each agent lives in its own sandbox named after it. Every command
# resumes a paused sandbox first, so idling never costs more than a few seconds.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/colincode"
ENV_FILE="$CONFIG_DIR/env"          # provider API keys, KEY=VALUE, mode 0600
AGENTS_DIR="$CONFIG_DIR/agents"     # one file per agent, KEY=VALUE
DEFAULT_HARNESS="${COLINCODE_HARNESS:-claude}"
DISK_GB="${COLINCODE_DISK_GB:-20}"
# Box sizes: name  vCPU  MiB.  COLINCODE_SIZE picks the default (or COLINCODE_CPU /
# COLINCODE_MEMORY_MB for an exact pair). Each agent remembers the size it was made with.
SIZES="small medium large xlarge xxlarge"
# Persistent volume: one per agent, mounted at $WORK_DIR, survives pause and rm.
# COLINCODE_VOLUME_GB is the default size offered (0 = no volume).
VOLUME_SIZES="10 25 50"   # tenki workspaces cap volumes (50 GiB seen); a larger size is refused at create
VOLUME_GB_DEFAULT="${COLINCODE_VOLUME_GB:-10}"
WORK_DIR=/home/tenki/work
A_NAME="" A_HARNESS="" A_PROVIDER="" A_MODEL="" A_CPU="" A_MEM="" A_VOLUME="" A_VOLUME_GB=0
size_spec() {   # name -> S_CPU S_MEM
  case "$1" in
    small)   S_CPU=2;  S_MEM=4096 ;;
    medium)  S_CPU=4;  S_MEM=8192 ;;
    large)   S_CPU=8;  S_MEM=16384 ;;
    xlarge)  S_CPU=12; S_MEM=32768 ;;
    xxlarge) S_CPU=16; S_MEM=65536 ;;
    *) return 1 ;;
  esac
}
is_size() { size_spec "$1" >/dev/null 2>&1; }
size_label() {   # cpu mem -> "4 vCPU · 8 GiB"
  printf '%s vCPU · %s GiB' "$1" "$(( $2 / 1024 ))"
}
size_short() { printf '%sc/%sg' "$1" "$(( $2 / 1024 ))"; }
default_size() {   # -> DEF_CPU DEF_MEM, from env or the medium preset
  if [ -n "${COLINCODE_SIZE:-}" ]; then
    is_size "$COLINCODE_SIZE" || die "COLINCODE_SIZE must be one of: $SIZES"
    size_spec "$COLINCODE_SIZE"; DEF_CPU=$S_CPU; DEF_MEM=$S_MEM
  else
    DEF_CPU="${COLINCODE_CPU:-4}"; DEF_MEM="${COLINCODE_MEMORY_MB:-8192}"
  fi
}
IMAGE="${COLINCODE_IMAGE:-}"
RESUME_TIMEOUT="${COLINCODE_RESUME_TIMEOUT:-3m}"
# Boxes are not sticky: tenki pauses one MAX_DURATION after each create or resume
# (the CLI can't set an idle timeout, and the workspace caps max-duration at 2h);
# colin resumes it on the next command. A sticky box never pauses (COLINCODE_STICKY=1).
STICKY="${COLINCODE_STICKY:-0}"
MAX_DURATION="${COLINCODE_MAX_DURATION:-2h}"          # pauses this long after each create or resume (tenki caps it at 2h)
PAUSE_RETENTION="${COLINCODE_PAUSE_RETENTION:-720h}"  # how long a paused box is kept
BOX_ENV='$HOME/.config/colincode/agent.env'   # runtime env inside the box (sourced by sh)
# PATH inside the box for non-login shells: uv/goose/omp/droid/adal in ~/.local/bin,
# npm -g installs under nvm's prefix (tenki's image), both off a plain sh's PATH.
BOX_PATH='export PATH="$HOME/.local/bin:$(npm prefix -g 2>/dev/null)/bin:$PATH"' 
BOX_PROXY='$HOME/.config/colincode/claude-proxy.py'   # Anthropic->OpenAI translator (claude only)
PROXY_PORT="${COLINCODE_PROXY_PORT:-8787}"

die()  { printf '\033[31mcolin:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[2m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[33m warn:\033[0m %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }
tty_ok() { [ -t 0 ] && [ -t 1 ]; }
shq()  { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }   # single-quote for sh
short() { if [ ${#1} -gt "$2" ]; then printf \'%s…\' "${1:0:$(($2-1))}"; else printf \'%s\' "$1"; fi; }   # truncate with an ellipsis

# ------------------------------------------------------------ harness registry
#
# All three ship in the tenki base image; H_INSTALL is only a fallback for
# custom images. H_LAUNCH runs inside tmux, so it must be interactive.

CLI_HARNESSES="claude codex opencode copilot gemini qwen crush goose kimi pi omp droid adal hermes openclaw grok amp prime-agent tinyfish anchor hotdata"
WEB_HARNESSES="opencode-web open-webui hermes-web openclaw-web durable-pi"
HARNESSES="$CLI_HARNESSES $WEB_HARNESSES"
# agentcamp's injector writes a provider into each CLI's own config (github.com/opencolin/agentcamp)
INJECT_URL="${COLINCODE_INJECT_URL:-https://agentcamp.dev/sandbox/inject-provider.sh}"

harness_spec() {
  H_NAME=$1
  H_LOGIN="" H_LOGGED_IN="" H_LAUNCH_NATIVE="" H_RUN="" H_VARS="" H_NOTE="" H_REMOTE=no
  H_KIND=cli H_PORT="" H_INJECT="" H_NO_CUSTOM="" H_CHECK="" H_LABEL=$1 H_IMAGE="" H_RAWARGS=no
  case "$1" in
    claude)
      H_LABEL="Claude Code"; H_NOTE="Remote Control from claude.ai/code"
      H_CMD=claude
      H_NATIVE=anthropic
      # Remote Control needs a full-scope login made with `claude auth login`
      # *inside the box*. Long-lived tokens (claude setup-token /
      # CLAUDE_CODE_OAUTH_TOKEN) and API keys are inference-only and Claude
      # Code refuses Remote Control with them, so nothing is injected for this
      # harness and any stale token in the box env is unset at launch. The
      # login is stored under $HOME in the box and survives pauses.
      # --remote-control only works on Anthropic itself (any other base URL,
      # proxy included, disables it), so it is appended for the native provider.
      H_LAUNCH='env -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_API_KEY claude'
      H_LAUNCH_NATIVE=' --remote-control {BOX}'
      H_RUN='env -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_API_KEY claude -p'
      H_VARS=""
      H_LOGIN='env -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_API_KEY claude auth login'
      H_LOGGED_IN='env -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_API_KEY claude auth status 2>/dev/null | grep -q "\"loggedIn\": true"'
      H_INSTALL='curl -fsSL https://claude.ai/install.sh | bash'
      H_REMOTE=yes
      ;;
    codex)
      H_LABEL="Codex CLI (OpenAI)"
      H_CMD=codex
      H_NATIVE=openai
      H_LAUNCH='codex'
      H_RUN='codex exec'
      H_VARS="OPENAI_API_KEY"
      H_INSTALL='npm install -g @openai/codex'
      H_REMOTE=no
      ;;
    opencode)
      H_LABEL="opencode"
      H_CMD=opencode
      H_NATIVE=opencode
      H_LAUNCH='opencode'
      H_RUN='opencode run'
      H_VARS="ANTHROPIC_API_KEY OPENAI_API_KEY"
      H_INSTALL='curl -fsSL https://opencode.ai/install | bash'
      H_REMOTE=no
      ;;
    copilot)
      H_LABEL="GitHub Copilot CLI"; H_CMD=copilot; H_NATIVE=github
      H_LAUNCH='copilot'; H_RUN='copilot -p'
      H_INSTALL='sudo -n npm install -g @github/copilot'
      H_NOTE="/login inside for GitHub's models; other providers via its own-model settings" ;;
    gemini)
      H_LABEL="Gemini CLI (Google)"; H_CMD=gemini; H_NATIVE=google
      H_NO_CUSTOM="Gemini CLI speaks only Google's API"
      H_LAUNCH='gemini'; H_RUN='gemini -p'
      H_INSTALL='sudo -n npm install -g @google/gemini-cli' ;;
    qwen)
      H_LABEL="Qwen Code (Alibaba)"; H_CMD=qwen; H_NATIVE=qwen; H_INJECT=qwen
      H_LAUNCH='qwen'; H_RUN='qwen -p'
      H_INSTALL='sudo -n npm install -g @qwen-code/qwen-code' ;;
    crush)
      H_LABEL="Crush (Charm)"; H_CMD=crush; H_NATIVE=crush; H_INJECT=crush
      H_LAUNCH='crush'; H_RUN='crush run'
      H_INSTALL='sudo -n npm install -g @charmland/crush' ;;
    goose)
      H_LABEL="Goose (Block)"; H_CMD=goose; H_NATIVE=goose; H_INJECT=goose
      H_LAUNCH='goose'; H_RUN='goose run -t'
      H_INSTALL='curl -fsSL https://github.com/block/goose/releases/download/stable/download_cli.sh | CONFIGURE=false bash' ;;
    kimi)
      H_LABEL="Kimi Code CLI (Moonshot)"; H_CMD=kimi; H_NATIVE=moonshot; H_INJECT=kimi
      H_LAUNCH='kimi'
      H_INSTALL='curl -fsSL https://code.kimi.com/kimi-code/install.sh | KIMI_INSTALL_DIR="$HOME/.local" KIMI_NO_MODIFY_PATH=1 bash' ;;
    pi)
      H_LABEL="Pi"; H_CMD=pi; H_NATIVE=pi; H_INJECT=pi
      H_IMAGE="tenki/pi:stable"
      H_LAUNCH='pi'; H_RUN='pi -p'
      H_INSTALL='echo "pi comes with the tenki/pi image; recreate the box (colin <agent> rm, then colin <agent>)"; exit 1'
      H_NOTE="tenki image · /login inside for a subscription, or any provider" ;;
    omp)
      H_LABEL="oh-my-pi"; H_CMD=omp; H_NATIVE=omp; H_INJECT=omp
      H_LAUNCH='omp'; H_RUN='omp -p'
      H_INSTALL='mkdir -p ~/.local/bin && curl -fsSL -o ~/.local/bin/omp https://github.com/can1357/oh-my-pi/releases/download/v18.10.3/omp-linux-x64 && chmod 755 ~/.local/bin/omp' ;;
    droid)
      H_LABEL="Droid (Factory)"; H_CMD=droid; H_NATIVE=factory; H_INJECT=droid
      H_IMAGE="tenki/droid:stable"
      H_LAUNCH='droid'; H_RUN='droid exec'
      H_INSTALL='echo "droid comes with the tenki/droid image; recreate the box (colin <agent> rm, then colin <agent>)"; exit 1'
      H_NOTE="tenki image · FACTORY_API_KEY or Factory sign-in; another provider is added to its /model list" ;;
    adal)
      H_LABEL="AdaL (SylphAI)"; H_CMD=adal; H_NATIVE=adal
      H_NO_CUSTOM="AdaL has no custom endpoint: an AdaL account or a ChatGPT subscription"
      H_LAUNCH='adal'
      H_INSTALL='curl -fsSL https://adal.sylph.ai/install.sh | ADAL_NO_TRACK=1 ADAL_NO_WARM=1 bash -s -- --no-modify-path; mkdir -p ~/.local/bin; ln -sf ~/.adal/bin/adal ~/.local/bin/adal' ;;
    hermes)
      H_LABEL="Hermes (Nous Research)"; H_CMD=hermes; H_NATIVE=hermes; H_INJECT=hermes
      H_LAUNCH='hermes'
      H_INSTALL='sudo -n npm install -g hermes-agent' ;;
    openclaw)
      H_LABEL="OpenClaw"; H_CMD=openclaw; H_NATIVE=openclaw; H_INJECT=openclaw
      H_LAUNCH='openclaw chat'
      H_INSTALL='sudo -n npm install -g openclaw' ;;
    # ---- tenki's pre-built images: the box itself is the harness
    grok)
      H_LABEL="Grok Build (xAI)"; H_CMD=grok; H_NATIVE=xai
      H_IMAGE="tenki/grok:stable"; H_NO_CUSTOM="Grok Build runs on xAI (XAI_API_KEY, or grok login --device-auth inside)"
      H_LAUNCH='grok'; H_RUN='grok -p'
      H_INSTALL='echo "grok comes with the tenki/grok image; recreate the box (colin <agent> rm, then colin <agent>)"; exit 1'
      H_NOTE="tenki image · XAI_API_KEY or device-code login" ;;
    amp)
      H_LABEL="Amp (Sourcegraph)"; H_CMD=amp; H_NATIVE=amp
      H_IMAGE="tenki/amp:stable"; H_NO_CUSTOM="Amp runs on Sourcegraph's models (AMP_API_KEY, or amp login inside)"
      H_LAUNCH='amp'; H_RUN='amp -x'
      H_INSTALL='echo "amp comes with the tenki/amp image; recreate the box (colin <agent> rm, then colin <agent>)"; exit 1'
      H_NOTE="tenki image · AMP_API_KEY or amp login" ;;
    anchor)
      H_LABEL="Anchor Browser toolkit"; H_CMD=anchor-smoke; H_NATIVE=anchor
      H_IMAGE="tenki/anchor:stable"; H_NO_CUSTOM="Anchor takes an Anchor key (playwright-core against Anchor-managed browsers)"
      H_LAUNCH='bash -l'
      H_INSTALL='echo "anchor-smoke comes with the tenki/anchor image; recreate the box (colin <agent> rm, then colin <agent>)"; exit 1'
      H_NOTE="tenki image · a shell with ANCHOR_API_KEY set; playwright-core and anchor-smoke" ;;
    hotdata)
      H_LABEL="Hotdata toolkit"; H_CMD=hotdata; H_NATIVE=hotdata
      H_IMAGE="tenki/hotdata:stable"; H_NO_CUSTOM="Hotdata takes a Hotdata key (databases, loads, SQL)"
      H_LAUNCH='bash -l'; H_RUN='hotdata'; H_RAWARGS=yes
      H_INSTALL='echo "hotdata comes with the tenki/hotdata image; recreate the box (colin <agent> rm, then colin <agent>)"; exit 1'
      H_NOTE="tenki image · a shell with HOTDATA_API_KEY set; run -- databases|query …" ;;
    prime-agent)
      H_LABEL="Prime Agent (Prime Intellect)"; H_CMD=prime-agent; H_NATIVE=prime
      H_IMAGE="tenki/prime-agent:stable"; H_NO_CUSTOM="Prime Agent runs on Prime Inference (PRIME_API_KEY); other providers' own keys can go in the box env"
      H_LAUNCH='prime-agent'; H_RUN='prime-agent -p'
      H_INSTALL='echo "prime-agent comes with the tenki/prime-agent image; recreate the box (colin <agent> rm, then colin <agent>)"; exit 1'
      H_NOTE="tenki image · Python-kernel coding and research agent" ;;
    tinyfish)
      H_LABEL="TinyFish web agent toolkit"; H_CMD=tinyfish; H_NATIVE=tinyfish
      H_IMAGE="tenki/tinyfish:stable"; H_NO_CUSTOM="TinyFish takes a TinyFish key (web agent, remote browser, fetch, search)"
      H_LAUNCH='bash -l'; H_RUN='tinyfish'; H_RAWARGS=yes
      H_INSTALL='echo "tinyfish comes with the tenki/tinyfish image; recreate the box (colin <agent> rm, then colin <agent>)"; exit 1'
      H_NOTE="tenki image · a shell with the key set; run -- agent|browser|fetch|search …" ;;
    # ---- web UIs: a server in the box, tunnelled to localhost on your machine. They
    # listen on all interfaces so a tenki preview URL (colin <agent> url) can reach
    # them; nothing outside the box can, until such a link exists.
    opencode-web)
      H_KIND=web; H_PORT=8086; H_LABEL="opencode web UI"; H_CMD=opencode; H_NATIVE=opencode
      H_LAUNCH='opencode serve --hostname 0.0.0.0 --port 8086'
      H_INSTALL='curl -fsSL https://opencode.ai/install | bash' ;;
    open-webui)
      H_KIND=web; H_PORT=8083; H_LABEL="Open WebUI"; H_CMD=open-webui; H_NATIVE=open-webui
      H_LAUNCH='open-webui serve --host 0.0.0.0 --port 8083'
      H_INSTALL='uv tool install --python 3.12 open-webui'
      H_NOTE="chat UI; a few GB to install" ;;
    hermes-web)
      H_KIND=web; H_PORT=8088; H_LABEL="Hermes web UI"; H_CMD=hermes; H_NATIVE=hermes; H_INJECT=hermes
      H_LAUNCH='hermes dashboard --host 0.0.0.0 --port 8088 --no-open'
      # the dashboard builds its web UI inside the (root-owned) npm package on first start
      H_CHECK='command -v hermes >/dev/null 2>&1 && [ -O "$(npm root -g)/hermes-agent" ]'
      H_INSTALL='sudo -n npm install -g hermes-agent && sudo -n chown -R "$(id -u):$(id -g)" "$(npm root -g)/hermes-agent"'
      H_NOTE="first start builds the UI (a few minutes)" ;;
    openclaw-web)
      H_KIND=web; H_PORT=8087; H_LABEL="OpenClaw web UI"; H_CMD=openclaw; H_NATIVE=openclaw; H_INJECT=openclaw
      H_LAUNCH='openclaw gateway run --bind lan --port 8087 --auth token --token "$COLIN_WEB_TOKEN" --allow-unconfigured --force'
      H_INSTALL='sudo -n npm install -g openclaw' ;;
    durable-pi)
      H_KIND=web; H_PORT=8092; H_LABEL="Durable Pi (agentcamp)"; H_CMD=node; H_NATIVE=pi; H_INJECT=pi
      H_CHECK='test -d ~/.durable-pi/node_modules/@earendil-works/pi-durable'
      H_LAUNCH='env PORT=8092 HOST=0.0.0.0 DURABLE_PI_DIR="$PWD/.durable-pi" node "$HOME/.durable-pi/server.mjs"'
      H_INSTALL='mkdir -p ~/.durable-pi && cd ~/.durable-pi && curl -fsSL https://agentcamp.dev/sandbox/durable-pi/server.mjs -o server.mjs && curl -fsSL https://agentcamp.dev/sandbox/durable-pi/index.html -o index.html && node -e "require(\"fs\").writeFileSync(\"package.json\", JSON.stringify({name:\"colin-durable-pi\",private:true,type:\"module\",dependencies:{\"@earendil-works/pi-durable\":\"1.2.0\",\"@earendil-works/pi-ai\":\"1.2.0\",\"@earendil-works/chord\":\"1.2.0\"}}))" && npm install --no-audit --no-fund --omit=dev'
      H_NOTE="pi that keeps working through restarts" ;;
    *) die "unknown harness '$1' (known: $HARNESSES)" ;;
  esac
}

is_harness() { case " $HARNESSES " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# ----------------------------------------------------------- provider registry
#
# P_OPENAI_URL    OpenAI-compatible base (…/v1) — used by codex (Responses API)
#                 and opencode
# P_ANTHROPIC_URL origin Claude Code can point ANTHROPIC_BASE_URL at; empty if
#                 the provider has no Anthropic Messages API, in which case
#                 claude talks to P_OPENAI_URL through the translation proxy
#                 below (claude_proxy_source)
# P_MODELS        space-separated model ids, first is the default
# P_OPENCODE      provider id in opencode's built-in catalog (models.dev), or
#                 (every supported provider is in that catalog)

PROVIDERS="anthropic openai opencode nebius boundless baseten friendli openrouter"
# each harness's own sign-in / in-app setup, selectable only for that harness
NATIVE_PROVIDERS="github google qwen moonshot factory xai amp crush goose pi omp adal hermes openclaw open-webui prime tinyfish anchor hotdata"

provider_spec() {
  P_NAME=$1
  P_NATIVE=no P_KEY_VAR="" P_KEY_OPTIONAL=no P_KEYS_URL="" P_OPENAI_URL="" P_ANTHROPIC_URL="" P_MODELS="" P_OPENCODE="" P_NOTE=""
  case "$1" in
    anthropic)  P_LABEL="Anthropic";  P_NATIVE=yes; P_NOTE="Claude Code default · Remote Control" ;;
    openai)     P_LABEL="OpenAI";     P_NATIVE=yes; P_NOTE="Codex default · codex login in the box" ;;
    opencode)   P_LABEL="opencode";   P_NATIVE=yes; P_NOTE="opencode default · configure inside opencode" ;;
    github)     P_LABEL="GitHub";     P_NATIVE=yes; P_NOTE="Copilot default · /login inside (needs a Copilot plan)" ;;
    google)     P_LABEL="Google";     P_NATIVE=yes; P_NOTE="Gemini CLI default · Google sign-in inside" ;;
    qwen)       P_LABEL="Qwen";       P_NATIVE=yes; P_NOTE="Qwen Code default · Qwen OAuth inside" ;;
    moonshot)   P_LABEL="Moonshot";   P_NATIVE=yes; P_NOTE="Kimi Code default · kimi login inside" ;;
    factory)    P_LABEL="Factory";    P_NATIVE=yes; P_KEY_VAR=FACTORY_API_KEY; P_KEY_OPTIONAL=yes; P_KEYS_URL="https://app.factory.ai/settings/api-keys"; P_NOTE="Droid default · FACTORY_API_KEY, or leave empty and sign in inside" ;;
    xai)        P_LABEL="xAI";        P_NATIVE=yes; P_KEY_VAR=XAI_API_KEY; P_KEY_OPTIONAL=yes; P_KEYS_URL="https://console.x.ai"; P_NOTE="Grok Build default · XAI_API_KEY, or leave empty for grok login --device-auth" ;;
    amp)        P_LABEL="Amp";        P_NATIVE=yes; P_KEY_VAR=AMP_API_KEY; P_KEY_OPTIONAL=yes; P_KEYS_URL="https://ampcode.com/settings"; P_NOTE="Amp default · AMP_API_KEY, or leave empty for amp login" ;;
    anchor)     P_LABEL="Anchor Browser"; P_NATIVE=yes; P_KEY_VAR=ANCHOR_API_KEY; P_KEYS_URL="https://app.anchorbrowser.io"; P_NOTE="ANCHOR_API_KEY" ;;
    hotdata)    P_LABEL="Hotdata";    P_NATIVE=yes; P_KEY_VAR=HOTDATA_API_KEY; P_KEYS_URL="https://www.hotdata.dev"; P_NOTE="HOTDATA_API_KEY (HOTDATA_WORKSPACE too, if your account needs it)" ;;
    prime)      P_LABEL="Prime Intellect"; P_NATIVE=yes; P_KEY_VAR=PRIME_API_KEY; P_KEY_OPTIONAL=yes; P_KEYS_URL="https://app.primeintellect.ai/dashboard/tokens"; P_NOTE="Prime Inference · PRIME_API_KEY, or leave empty and log in inside" ;;
    tinyfish)   P_LABEL="TinyFish";   P_NATIVE=yes; P_KEY_VAR=TINYFISH_API_KEY; P_KEYS_URL="https://agent.tinyfish.ai/api-keys"; P_NOTE="TINYFISH_API_KEY" ;;
    crush|goose|pi|omp|adal|hermes|openclaw|open-webui)
                P_LABEL="$1's own setup"; P_NATIVE=yes; P_NOTE="pick a provider and key inside $1" ;;
    nebius)
      P_LABEL="Nebius Token Factory"; P_KEY_VAR=NEBIUS_API_KEY
      P_KEYS_URL="https://tokenfactory.nebius.com/project/api-keys"
      P_OPENAI_URL="https://api.tokenfactory.nebius.com/v1"
      P_MODELS="moonshotai/Kimi-K3 zai-org/GLM-5.3 moonshotai/Kimi-K2.7-Code deepseek-ai/DeepSeek-V4-Pro-0813 Qwen/Qwen3.5-397B-A17B meta-models/muse-spark-open MiniMaxAI/MiniMax-M3 nvidia/Nemotron-3-Ultra-550b-a55b deepseek-ai/DeepSeek-V4.1-Flash zai-org/GLM-5.2"
      P_OPENCODE=nebius ;;
    boundless)
      P_LABEL="Boundless"; P_KEY_VAR=BOUNDLESS_API_KEY
      P_KEYS_URL="https://inference.boundless.network/api-keys"
      P_OPENAI_URL="https://api.inference.boundless.network/v1"
      P_ANTHROPIC_URL="https://api.inference.boundless.network"
      P_MODELS="claude-fable-5.1 claude-opus-5.5 gpt-6-sol gpt-5.6-sol kimi-k3 glm-5.3 deepseek-v4-pro-0813 minimax-m3 deepseek-v4.1-flash mimo-v2.6-pro"
      P_OPENCODE=boundless ;;
    baseten)
      P_LABEL="Baseten"; P_KEY_VAR=BASETEN_API_KEY
      P_KEYS_URL="https://app.baseten.co/settings/api_keys"
      P_OPENAI_URL="https://inference.baseten.co/v1"
      P_ANTHROPIC_URL="https://inference.baseten.co"
      P_MODELS="moonshotai/Kimi-K3 zai-org/GLM-5.3 zai-org/GLM-5.3-Fast deepseek-ai/DeepSeek-V4-Pro-0813 deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B deepseek-ai/DeepSeek-V4.1-Flash openai/gpt-oss-120b zai-org/GLM-5.3-Flash zai-org/GLM-5.2"
      P_OPENCODE=baseten ;;
    friendli)
      P_LABEL="Friendli"; P_KEY_VAR=FRIENDLI_TOKEN
      P_KEYS_URL="https://friendli.ai/suite/~/setting/keys"
      P_OPENAI_URL="https://api.friendli.ai/serverless/v1"
      P_ANTHROPIC_URL="https://api.friendli.ai/serverless"
      P_MODELS="zai-org/GLM-5.3 zai-org/GLM-5.3-Flash zai-org/GLM-5.2 zai-org/GLM-5.1 google/gemma-4-31B-it"
      P_OPENCODE=friendli ;;
    openrouter)
      P_LABEL="OpenRouter"; P_KEY_VAR=OPENROUTER_API_KEY
      P_KEYS_URL="https://openrouter.ai/keys"
      P_OPENAI_URL="https://openrouter.ai/api/v1"
      P_ANTHROPIC_URL="https://openrouter.ai/api"
      P_MODELS="anthropic/claude-fable-5.1 anthropic/claude-opus-5.5 openai/gpt-6-astra openai/gpt-5.5 google/gemini-3.1-pro-preview moonshotai/kimi-k3 moonshotai/kimi-k3.1-pro anthropic/claude-sonnet-5.5 z-ai/glm-5.3 qwen/qwen3-coder-next"
      P_OPENCODE=openrouter ;;
    *) die "unknown provider '$1' (known: $PROVIDERS)" ;;
  esac
}

is_provider() { case " $PROVIDERS $NATIVE_PROVIDERS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# Why can't harness $1 use provider $2? Prints nothing if it can.
provider_blocker() {
  local h=$1 p=$2
  harness_spec "$h"
  if [ "$p" != "$H_NATIVE" ] && [ -n "$H_NO_CUSTOM" ]; then printf '%s\n' "$H_NO_CUSTOM"; return 0; fi
  provider_spec "$p"
  if [ "$P_NATIVE" = yes ]; then
    [ "$H_NATIVE" = "$p" ] || printf "%s is another harness's default\n" "$p"
    return 0
  fi
  [ -n "$P_OPENAI_URL" ] || [ -n "$P_ANTHROPIC_URL" ] || printf 'no API endpoint known\n'
}

# Does the loaded agent (A_*) need the in-box Anthropic->OpenAI proxy? True for
# claude on a provider that has an OpenAI-compatible URL but no Anthropic one.
agent_proxied() {
  [ "$A_HARNESS" = claude ] || return 1
  provider_spec "$A_PROVIDER"
  [ "$P_NATIVE" = no ] && [ -z "$P_ANTHROPIC_URL" ] && [ -n "$P_OPENAI_URL" ]
}

# ------------------------------------------------------------- local config

get_var() {   # from the environment first, then $ENV_FILE
  local val="${!1:-}"
  if [ -z "$val" ] && [ -f "$ENV_FILE" ]; then
    val=$(sed -n "s/^$1=//p" "$ENV_FILE" | head -n1)
  fi
  printf '%s' "$val"
}

store_var() {
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  umask 077
  touch "$ENV_FILE"; chmod 600 "$ENV_FILE"
  local tmp; tmp=$(mktemp)
  grep -v "^$1=" "$ENV_FILE" > "$tmp" 2>/dev/null || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$ENV_FILE"; chmod 600 "$ENV_FILE"
}

# Hidden-input prompt for a secret. Returns 1 if left blank.
prompt_secret() {
  local var=$1 val
  printf '  \033[1m%s\033[0m\n  \033[2m> paste, or leave empty to skip\033[0m\r  > ' "$var" >&2
  IFS= read -rs val </dev/tty; printf '\n' >&2
  [ -n "$val" ] || return 1
  store_var "$var" "$val"
  info "stored $var in $ENV_FILE (0600)"
}

# Make sure the key for provider $1 exists; prompt on a terminal if not.
ensure_provider_key() {
  provider_spec "$1"
  [ -n "$P_KEY_VAR" ] || return 0
  [ -n "$(get_var "$P_KEY_VAR")" ] && return 0
  if [ "$P_KEY_OPTIONAL" = yes ]; then
    tty_ok || return 0
    info "$P_LABEL key — create one at $P_KEYS_URL, or leave it empty to sign in inside the box"
    prompt_secret "$P_KEY_VAR" || info "no key stored — sign in inside the box when the agent starts"
    return 0
  fi
  tty_ok || die "no $P_KEY_VAR for $P_LABEL — add it to $ENV_FILE (keys: $P_KEYS_URL)"
  info "$P_LABEL needs an API key — create one at $P_KEYS_URL"
  prompt_secret "$P_KEY_VAR" || die "no $P_KEY_VAR stored"
}

# Native-provider credentials injected at box creation (codex, opencode).
harness_env() {
  local var val
  for var in $H_VARS; do
    val=$(get_var "$var"); [ -n "$val" ] || continue
    printf '%s=%s\n' "$var" "$val"
  done
  return 0
}

# ------------------------------------------------------------------- agents
#
# $AGENTS_DIR/<name>:  HARNESS=… PROVIDER=… MODEL=… CPU=… MEM_MB=… VOLUME=<id> VOLUME_GB=…
# (sandbox is named <name>; VOLUME is empty until the volume is created, VOLUME_GB=0 means none)

agent_file() { printf '%s/%s\n' "$AGENTS_DIR" "$1"; }
agent_exists() { [ -f "$(agent_file "$1")" ]; }

agent_load() {
  local f; f=$(agent_file "$1")
  [ -f "$f" ] || die "no agent named '$1' (colin ls)"
  A_NAME=$1
  A_HARNESS=$(sed -n 's/^HARNESS=//p' "$f" | head -n1)
  A_PROVIDER=$(sed -n 's/^PROVIDER=//p' "$f" | head -n1)
  A_MODEL=$(sed -n 's/^MODEL=//p' "$f" | head -n1)
  A_CPU=$(sed -n 's/^CPU=//p' "$f" | head -n1)
  A_MEM=$(sed -n 's/^MEM_MB=//p' "$f" | head -n1)
  A_VOLUME=$(sed -n 's/^VOLUME=//p' "$f" | head -n1)
  A_VOLUME_GB=$(sed -n 's/^VOLUME_GB=//p' "$f" | head -n1)
  [ -n "$A_VOLUME_GB" ] || A_VOLUME_GB=0     # agents from before volumes: none
  default_size
  [ -n "$A_CPU" ] || A_CPU=$DEF_CPU
  [ -n "$A_MEM" ] || A_MEM=$DEF_MEM
  is_harness "$A_HARNESS" || die "agent '$1' has an unknown harness '$A_HARNESS'"
  harness_spec "$A_HARNESS"
  [ -n "$A_PROVIDER" ] || A_PROVIDER=$H_NATIVE
}

agent_save() {   # name harness provider model [cpu mem_mb [volume_id volume_gb]]
  local cpu=${5:-} mem=${6:-} vol=${7:-} vgb=${8:-0}
  if [ -z "$cpu" ] || [ -z "$mem" ]; then default_size; cpu=${cpu:-$DEF_CPU}; mem=${mem:-$DEF_MEM}; fi
  mkdir -p "$AGENTS_DIR"; chmod 700 "$CONFIG_DIR" "$AGENTS_DIR" 2>/dev/null || true
  printf 'HARNESS=%s\nPROVIDER=%s\nMODEL=%s\nCPU=%s\nMEM_MB=%s\nVOLUME=%s\nVOLUME_GB=%s\n' \
    "$2" "$3" "$4" "$cpu" "$mem" "$vol" "$vgb" > "$(agent_file "$1")"
}
agent_resave() { agent_save "$A_NAME" "$A_HARNESS" "$A_PROVIDER" "$A_MODEL" "$A_CPU" "$A_MEM" "$A_VOLUME" "$A_VOLUME_GB"; }

# ---- persistent volumes (tenki sandbox volume …, addressed by id)
volume_state() {   # id -> AVAILABLE | IN_USE | MISSING | …
  [ -n "$1" ] || { printf MISSING; return 0; }
  tenki sandbox volume get "$1" --json 2>/dev/null | jq -r '.state // "MISSING"' || printf MISSING
}
wait_volume_available() {   # id — detach after terminate/pause is asynchronous
  local i; for i in $(seq 1 40); do
    case "$(volume_state "$1")" in AVAILABLE|MISSING) return 0 ;; esac; sleep 2
  done; return 1
}
volume_gb() { tenki sandbox volume get "$1" --json 2>/dev/null | jq -r '(.size_bytes // 0) / 1073741824 | floor'; }

# Make sure the agent's volume exists (creating it when needed). Sets A_VOLUME.
ensure_volume() {
  [ "${A_VOLUME_GB:-0}" -gt 0 ] 2>/dev/null || return 0
  if [ -n "$A_VOLUME" ] && [ "$(volume_state "$A_VOLUME")" != MISSING ]; then return 0; fi
  info "creating a ${A_VOLUME_GB} GiB volume for '$A_NAME' (mounted at $WORK_DIR, survives rm)"
  local out cap
  if ! out=$(tenki sandbox volume create --name "$A_NAME" --size "${A_VOLUME_GB}GiB" --json 2>&1); then
    cap=$(printf '%s' "$out" | grep -oE 'limit of [0-9]+ ?GiB' | grep -oE '[0-9]+' | head -1)
    warn "$(printf '%s' "$out" | tail -1 | sed 's/^failed to create volume: //; s/^/failed to create volume: /')"
    if [ -n "$cap" ]; then
      die "this workspace allows volumes up to ${cap} GiB — pick a smaller one: colin $A_NAME volume $cap   (or: colin $A_NAME volume none)"
    fi
    die "fix the cause, or change the size: colin $A_NAME volume <GiB|none>"
  fi
  A_VOLUME=$(printf '%s' "$out" | jq -r .id)
  [ -n "$A_VOLUME" ] && [ "$A_VOLUME" != null ] || die "failed to create the volume"
  agent_resave
}

agent_names() { [ -d "$AGENTS_DIR" ] && ls -1 "$AGENTS_DIR" 2>/dev/null | sort || true; }

agents_for_harness() {
  local n
  for n in $(agent_names); do
    grep -q "^HARNESS=$1\$" "$(agent_file "$n")" && printf '%s\n' "$n"
  done
  return 0
}

valid_name() { printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,62}$'; }
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g; s/--*/-/g; s/^-//; s/-$//'; }

auto_name() {   # provider harness -> provider-harness[-N], unused by agents or boxes
  local base n i
  base="$1-$2"; n=$base; i=2
  while agent_exists "$n" || [ "$(state_of "$n")" != MISSING ]; do n="$base-$i"; i=$((i+1)); done
  printf '%s\n' "$n"
}

# Adopt boxes created by older colin versions (colincode-<harness>) as agents.
migrate_legacy_boxes() {
  [ -n "$(agent_names)" ] && return 0
  local h box
  for h in $HARNESSES; do
    box="colincode-$h"
    [ "$(state_of "$box")" = MISSING ] && continue
    harness_spec "$h"
    agent_save "$box" "$h" "$H_NATIVE" ""
    info "adopted existing box '$box' as an agent"
  done
}


# ------------------------------------------------------------------- menu
#
# menu "Title" default_index item... -> sets MENU_INDEX (0-based) and MENU_VALUE
# to the first word of the chosen item. Arrows / PgUp / PgDn move through a
# 12-row window, typing filters the list, Backspace edits the filter, Enter
# picks the highlighted row, Esc clears the filter (or cancels), Ctrl-C
# cancels. Falls back to a numbered prompt without a terminal.
menu() {
  local title=$1 cur=$2; shift 2
  local all=("$@") n=$# i key filter="" rows=12
  MENU_INDEX=$cur; MENU_VALUE=${all[$cur]%% *}
  if ! tty_ok || ! command -v tput >/dev/null 2>&1; then
    printf '%s\n' "$title" >&2
    for ((i=0;i<n;i++)); do printf '  %d) %s\n' "$((i+1))" "${all[$i]}" >&2; done
    printf 'Choice [%d]: ' "$((cur+1))" >&2
    read -r key </dev/tty || key=
    key=${key:-$((cur+1))}
    case "$key" in ''|*[!0-9]*) die "not a choice: '$key'" ;; esac
    [ "$key" -ge 1 ] && [ "$key" -le "$n" ] || die "not a choice: '$key'"
    MENU_INDEX=$((key-1)); MENU_VALUE=${all[$MENU_INDEX]%% *}
    return 0
  fi
  local bold dim rst; bold=$(tput bold); dim=$(tput dim); rst=$(tput sgr0)
  # idx[] = indices into all[] that match the filter; pos = cursor within idx[]
  local idx=() pos=0 drawn=0 top=0
  refilter() {
    idx=(); local j lf; lf=$(printf '%s' "$filter" | tr 'A-Z' 'a-z')
    for ((j=0;j<n;j++)); do
      case "$(printf '%s' "${all[$j]}" | tr 'A-Z' 'a-z')" in *"$lf"*) idx+=("$j") ;; esac
    done
    [ "$pos" -lt "${#idx[@]}" ] || pos=$(( ${#idx[@]} > 0 ? ${#idx[@]}-1 : 0 ))
  }
  draw() {
    local m=${#idx[@]} j lines=0 hint
    [ "$pos" -lt "$top" ] && top=$pos
    [ "$pos" -ge $((top+rows)) ] && top=$((pos-rows+1))
    if [ -n "$filter" ]; then hint="  ${dim}filter: ${rst}${filter}${dim}  (${m} of ${n}, Esc clears)${rst}"
    elif [ "$m" -gt "$rows" ]; then hint="  ${dim}${m} options · ↑↓ scroll · type to filter${rst}"
    else hint=""; fi
    printf '\r  %s%s%s%s\033[K\n' "$bold" "$title" "$rst" "$hint"; lines=1
    for ((j=top; j<top+rows && j<m; j++)); do
      if [ "$j" -eq "$pos" ]; then printf '  %s>%s %s%s%s\033[K\n' "$bold" "$rst" "$bold" "${all[${idx[$j]}]}" "$rst"
      else printf '    %s%s%s\033[K\n' "$dim" "${all[${idx[$j]}]}" "$rst"; fi
      lines=$((lines+1))
    done
    [ "$m" -eq 0 ] && { printf '    %sno match%s\033[K\n' "$dim" "$rst"; lines=$((lines+1)); }
    # blank out rows left over from a taller previous frame
    for ((j=lines; j<drawn; j++)); do printf '\033[K\n'; done
    [ "$drawn" -gt "$lines" ] && printf '\033[%dA' "$((drawn-lines))"
    drawn=$lines
  }
  tput civis 2>/dev/null; stty -echo 2>/dev/null
  trap 'tput cnorm 2>/dev/null; stty echo 2>/dev/null' RETURN
  refilter; pos=$cur; draw
  while :; do
    IFS= read -rsn1 key </dev/tty || key=q
    case "$key" in
      $'\x1b')
        IFS= read -rsn2 -t 1 key </dev/tty || key=
        case "$key" in
          '[A'|'OA') [ ${#idx[@]} -gt 0 ] && pos=$(( (pos+${#idx[@]}-1) % ${#idx[@]} )) ;;
          '[B'|'OB') [ ${#idx[@]} -gt 0 ] && pos=$(( (pos+1) % ${#idx[@]} )) ;;
          '[5') IFS= read -rsn1 -t 1 key </dev/tty || true; pos=$(( pos-rows > 0 ? pos-rows : 0 )) ;;
          '[6') IFS= read -rsn1 -t 1 key </dev/tty || true; pos=$(( pos+rows < ${#idx[@]} ? pos+rows : ${#idx[@]}-1 )) ;;
          '') if [ -n "$filter" ]; then filter=""; refilter; else printf '\n'; die "cancelled"; fi ;;
        esac ;;
      ''|$'\n'|$'\r') [ ${#idx[@]} -gt 0 ] && break ;;
      $'\x7f'|$'\x08') filter=${filter%?}; refilter ;;
      $'\x03') printf '\n'; die "cancelled" ;;
      [[:print:]]) filter="$filter$key"; pos=0; refilter ;;
    esac
    printf '\033[%dA' "$drawn"; draw
  done
  printf '\n'
  MENU_INDEX=${idx[$pos]}; MENU_VALUE=${all[$MENU_INDEX]%% *}
}

state_of() {
  local out state
  if ! out=$(tenki sandbox get "$1" --json 2>/dev/null); then
    printf 'MISSING\n'; return 0
  fi
  state=$(printf '%s' "$out" | jq -r '[.. | objects | .state? // empty] | first // empty' 2>/dev/null || true)
  [ -n "$state" ] || { printf 'UNKNOWN\n'; return 0; }
  state=$(printf '%s' "$state" | tr '[:lower:]' '[:upper:]')
  case "$state" in
    *RUNNING*|*READY*)             printf 'RUNNING\n' ;;
    *PAUSING*)                     printf 'PAUSING\n' ;;
    *PAUS*)                        printf 'PAUSED\n'  ;;
    *CREAT*|*START*|*PEND*|*PROV*) printf 'PENDING\n' ;;
    *) printf '%s\n' "$state" ;;
  esac
}
wait_running() {
  local name=$1 deadline=$((SECONDS + 300)) st
  while [ "$SECONDS" -lt "$deadline" ]; do
    st=$(state_of "$name")
    [ "$st" = RUNNING ] && return 0
    [ "$st" = PENDING ] || die "sandbox '$name' went to state $st while waiting for RUNNING"
    sleep 3
  done
  die "timed out waiting for '$name' to reach RUNNING"
}
wait_state() {
  local name=$1 want=$2 deadline=$((SECONDS + 300)) st
  while [ "$SECONDS" -lt "$deadline" ]; do
    st=$(state_of "$name")
    [ "$st" = "$want" ] && return 0
    sleep 3
  done
  die "timed out waiting for '$name' to reach $want (last: $st)"
}
resume_box() {
  local name=$1
  info "'$name' is paused — resuming"
  tenki sandbox resume "$name" --wait --wait-timeout "$RESUME_TIMEOUT" >/dev/null \
    || die "resume failed for '$name'"
  info "resumed"
}

provision() {
  local name=$1
  if ! sb_exec "$name" "command -v tmux >/dev/null 2>&1" >/dev/null 2>&1; then
    info "installing tmux"
    sb_exec "$name" 'sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq tmux' >/dev/null \
      || die "could not install tmux in '$name'"
  fi
  # Let tmux forward copies to the local clipboard over ssh (OSC 52). Works
  # with iTerm2 (enable "Applications in terminal may access clipboard"),
  # Ghostty, kitty, WezTerm, Alacritty; not Terminal.app.
  sb_exec "$name" 'f=~/.tmux.conf; grep -q set-clipboard "$f" 2>/dev/null || printf "set -g set-clipboard on\nset -as terminal-features \",xterm*:clipboard\"\nset -g allow-passthrough on\n" >> "$f"' >/dev/null 2>&1 || true
  local check=${H_CHECK:-"command -v $H_CMD >/dev/null 2>&1"}
  if ! sb_exec "$name" "$BOX_PATH; $check" >/dev/null 2>&1; then
    info "installing $H_LABEL in '$name' (not in this image; a minute or two)"
    sb_exec "$name" "$BOX_PATH; $H_INSTALL" >/dev/null || die "could not install $H_LABEL in '$name'"
    sb_exec "$name" "$BOX_PATH; $check" >/dev/null 2>&1 || die "$H_LABEL installed but '$H_CMD' is not on the box PATH"
  fi
  if agent_proxied && ! sb_exec "$name" "command -v python3 >/dev/null 2>&1 && command -v curl >/dev/null 2>&1" >/dev/null 2>&1; then
    info "installing python3 for the claude proxy"
    sb_exec "$name" 'sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3 curl' >/dev/null \
      || die "could not install python3 in '$name' (the claude proxy needs it)"
  fi
}
# Claude Code first-run wizard (theme, trust) blocks Remote Control; skip it.
seed_claude_config() {
  local name=$1
  sb_exec "$name" 'f="$HOME/.claude.json"; [ -s "$f" ] || printf "{}\n" > "$f";
    if command -v jq >/dev/null 2>&1; then
      jq --arg h "$HOME" ".hasCompletedOnboarding=true | .theme=(.theme // \"dark\") | .projects[\$h].hasTrustDialogAccepted=true" "$f" > "$f.tmp" && mv "$f.tmp" "$f";
    else
      printf "{\"hasCompletedOnboarding\":true,\"theme\":\"dark\",\"projects\":{\"%s\":{\"hasTrustDialogAccepted\":true}}}\n" "$HOME" > "$f";
    fi' >/dev/null 2>&1 || warn "could not pre-seed Claude Code onboarding; you may see the first-run wizard"
}
box_login() {
  local name=$1
  [ -t 0 ] && [ -t 1 ] || die "signing in needs a terminal - run: colin $H_NAME auth"
  info "signing in to $H_NAME inside '$name' (open the URL it prints, then paste the code)"
  # ssh flags must follow "--" or the tenki CLI tries to parse them itself
  tenki sandbox ssh "$name" -- -t "$H_LOGIN" || die "sign-in did not complete"
  box_logged_in "$name" || die "sign-in did not stick; try again with: colin $H_NAME auth"
  info "signed in - the login is stored in the box and survives pauses"
}

# ------------------------------------------------------------- sandbox state

create_box() {   # name harness provider [cpu mem_mb]
  local name=$1 h=$2 p=$3 args=() line key
  local cpu=${4:-${A_CPU:-}} mem=${5:-${A_MEM:-}}
  if [ -z "$cpu" ] || [ -z "$mem" ]; then default_size; cpu=${cpu:-$DEF_CPU}; mem=${mem:-$DEF_MEM}; fi
  args=(--name "$name"
        --cpu "$cpu" --memory-mb "$mem" --disk-size-gb "$DISK_GB"
        --tags colincode --tags "harness:$h" --tags "provider:$p")
  local got=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    args+=(--env "$line"); got=1
  done < <(harness_env)
  if [ "$got" = 0 ] && [ -n "$H_VARS" ] && [ "$p" = "$H_NATIVE" ]; then
    warn "no credentials found for $h (looked for: $H_VARS)"
    warn "sign in inside the box instead: colin $name shell, then $H_CMD login"
  fi
  harness_spec "$2"
  local img=${H_IMAGE:-$IMAGE}
  [ -n "$img" ] && args+=(--image "$img")
  local life
  if [ "$STICKY" = 1 ]; then args+=(--sticky); life=sticky
  else args+=(--max-duration "$MAX_DURATION" --pause-retention "$PAUSE_RETENTION"); life="pauses after $MAX_DURATION"; fi
  ensure_volume; [ -n "$A_VOLUME" ] && args+=(--volume "$A_VOLUME:$WORK_DIR")
  for key in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_rsa.pub"; do
    [ -f "$key" ] && { args+=(--authorized-keys-file "$key"); break; }
  done
  info "creating '$name' for $h ($(size_label "$cpu" "$mem"), ${DISK_GB}GiB disk${A_VOLUME:+, ${A_VOLUME_GB}GiB volume}${img:+, image $img}, $life)"
  tenki sandbox create "${args[@]}" >/dev/null
  wait_running "$name"
}

# Resume-if-paused, create-if-absent. Every command path goes through here.
ensure_running() {   # name harness provider
  local name=$1 st
  st=$(state_of "$name")
  case "$st" in
    MISSING) create_box "$1" "$2" "$3" ;;
    RUNNING) : ;;
    PAUSING)
      info "'$name' is still pausing — waiting for it to settle"
      wait_state "$name" PAUSED
      resume_box "$name"
      ;;
    PAUSED)  resume_box "$name" ;;
    PENDING) info "'$name' is still starting — waiting"; wait_running "$name" ;;
    *) die "'$name' is in state $st — not usable (colin $name rm to clear it)" ;;
  esac
  ensure_attached "$name"
}

# A volume detached for a resize (or by hand) is attached again here.
ensure_attached() {
  [ -n "${A_VOLUME:-}" ] && [ "${A_NAME:-}" = "$1" ] || return 0
  [ "$(volume_state "$A_VOLUME")" = AVAILABLE ] || return 0
  info "attaching volume $A_VOLUME at $WORK_DIR"
  tenki sandbox volume attach "$1" "$A_VOLUME" --mount "$WORK_DIR" >/dev/null || warn "could not attach the volume"
}

# ------------------------------------------------------------------- in-guest

sb_exec() { tenki sandbox exec --session "$1" -c "$2"; }

# Codex asks "do you trust this directory?" on first start; answer it up front.
seed_codex_trust() {
  sb_exec "$1" 'mkdir -p ~/.codex; f=~/.codex/config.toml; touch "$f";
    grep -q "^\[projects\.\"$HOME\"\]" "$f" 2>/dev/null || printf "\n[projects.\"%s\"]\ntrust_level = \"trusted\"\n" "$HOME" >> "$f"' >/dev/null 2>&1 || true
}

box_logged_in() { sb_exec "$1" "$H_LOGGED_IN" >/dev/null 2>&1; }

# -------------------------------------------------------------- claude proxy
#
# Claude Code only speaks the Anthropic Messages API. For providers that expose
# just an OpenAI-compatible /chat/completions (Nebius Token Factory), colin ships
# this stdlib-only Python translator into the box ($BOX_PROXY), runs it in its
# own tmux session on 127.0.0.1:$PROXY_PORT, and points ANTHROPIC_BASE_URL at
# it. Streaming and tool calls are translated; thinking blocks are dropped.
# Debug it in the box with: tmux attach -t claude-proxy

claude_proxy_source() {
cat <<'PYEOF'
#!/usr/bin/env python3
# colincode claude-proxy — Anthropic Messages API in front of an
# OpenAI-compatible chat-completions endpoint. Stdlib only.
#
# Claude Code only speaks the Anthropic Messages API, so providers that expose
# just /v1/chat/completions (Nebius Token Factory, …) need this translator in
# between. It listens on 127.0.0.1 inside the box; colin points
# ANTHROPIC_BASE_URL at it and starts it from the same agent.env.
#
# Env (from ~/.config/colincode/agent.env):
#   COLIN_PROVIDER_URL   OpenAI-compatible base, e.g. https://api.example.com/v1
#   COLIN_PROVIDER_KEY   bearer token for that base
#   COLIN_MODEL          upstream model id; any "claude-*" model Claude Code asks
#                        for is mapped to it, other ids pass through unchanged
#   COLIN_PROXY_PORT     listen port (default 8787)
import json, os, sys, time, uuid, urllib.request, urllib.error
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

UPSTREAM = os.environ.get("COLIN_PROVIDER_URL", "").rstrip("/")
KEY = os.environ.get("COLIN_PROVIDER_KEY", "")
MODEL = os.environ.get("COLIN_MODEL", "")
PORT = int(os.environ.get("COLIN_PROXY_PORT", "8787"))
TIMEOUT = 600  # reasoning models can take minutes before the first byte


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, file=sys.stderr, flush=True)


# ------------------------------------------------------ request translation

def text_of(content):
    """Flatten Anthropic content (str or blocks) to plain text."""
    if isinstance(content, str):
        return content
    out = []
    for b in content or []:
        if isinstance(b, str):
            out.append(b)
        elif b.get("type") == "text":
            out.append(b.get("text", ""))
        elif b.get("type") == "tool_result":
            out.append(text_of(b.get("content", "")))
        elif b.get("type") == "image":
            out.append("[image]")
    return "".join(out)


def user_parts(blocks):
    """Anthropic user text/image blocks -> OpenAI content (str or parts)."""
    parts, has_image = [], False
    for b in blocks:
        t = b.get("type")
        if t == "text":
            parts.append({"type": "text", "text": b.get("text", "")})
        elif t == "image":
            src = b.get("source", {})
            if src.get("type") == "base64":
                url = "data:%s;base64,%s" % (src.get("media_type", "image/png"), src.get("data", ""))
            else:
                url = src.get("url", "")
            parts.append({"type": "image_url", "image_url": {"url": url}})
            has_image = True
    if not has_image:
        return "".join(p["text"] for p in parts)
    return parts


def convert_messages(req):
    msgs = []
    system = req.get("system")
    if system:
        msgs.append({"role": "system", "content": text_of(system)})
    for m in req.get("messages", []):
        role, content = m.get("role"), m.get("content")
        if isinstance(content, str):
            msgs.append({"role": role, "content": content})
            continue
        if role == "user":
            plain = []
            for b in content or []:
                if b.get("type") == "tool_result":
                    if plain:
                        msgs.append({"role": "user", "content": user_parts(plain)}); plain = []
                    msgs.append({"role": "tool", "tool_call_id": b.get("tool_use_id", ""),
                                 "content": text_of(b.get("content", "")) or "(no output)"})
                else:
                    plain.append(b)
            if plain:
                msgs.append({"role": "user", "content": user_parts(plain)})
        else:  # assistant: text + tool_use (thinking blocks are dropped)
            text, calls = "", []
            for b in content or []:
                t = b.get("type")
                if t == "text":
                    text += b.get("text", "")
                elif t == "tool_use":
                    calls.append({"id": b.get("id", ""), "type": "function",
                                  "function": {"name": b.get("name", ""),
                                               "arguments": json.dumps(b.get("input", {}))}})
            out = {"role": "assistant", "content": text or None}
            if calls:
                out["tool_calls"] = calls
            if text or calls:
                msgs.append(out)
    return msgs


def convert_tools(req):
    tools = []
    for t in req.get("tools", []):
        if "input_schema" not in t:   # server tools (web_search, …) have no schema
            continue
        tools.append({"type": "function", "function": {
            "name": t["name"], "description": t.get("description", ""),
            "parameters": t.get("input_schema", {"type": "object", "properties": {}})}})
    return tools


def convert_tool_choice(tc):
    if not tc:
        return None
    t = tc.get("type")
    if t == "any":
        return "required"
    if t == "tool":
        return {"type": "function", "function": {"name": tc.get("name", "")}}
    if t == "none":
        return "none"
    return "auto"


def upstream_body(req):
    model = req.get("model", "")
    if not model or model.startswith("claude") or not MODEL:
        model = MODEL or model
    body = {"model": model, "messages": convert_messages(req), "stream": bool(req.get("stream"))}
    if req.get("max_tokens"):
        body["max_tokens"] = req["max_tokens"]
    for k in ("temperature", "top_p"):
        if k in req:
            body[k] = req[k]
    if req.get("stop_sequences"):
        body["stop"] = req["stop_sequences"]
    tools = convert_tools(req)
    if tools:
        body["tools"] = tools
        tc = convert_tool_choice(req.get("tool_choice"))
        if tc:
            body["tool_choice"] = tc
    if body["stream"]:
        body["stream_options"] = {"include_usage": True}
    return body


# ----------------------------------------------------- response translation

STOP = {"stop": "end_turn", "length": "max_tokens", "tool_calls": "tool_use", "content_filter": "end_turn"}


def parse_args(s):
    try:
        return json.loads(s) if s and s.strip() else {}
    except ValueError:
        return {"_raw": s}


def usage_of(u):
    u = u or {}
    return {"input_tokens": u.get("prompt_tokens", 0) or 0, "output_tokens": u.get("completion_tokens", 0) or 0}


def convert_response(model, data):
    choice = (data.get("choices") or [{}])[0]
    msg = choice.get("message", {})
    content = []
    if msg.get("content"):
        content.append({"type": "text", "text": msg["content"]})
    for c in msg.get("tool_calls") or []:
        fn = c.get("function", {})
        content.append({"type": "tool_use", "id": c.get("id") or "call_" + uuid.uuid4().hex[:24],
                        "name": fn.get("name", ""), "input": parse_args(fn.get("arguments", ""))})
    if not content:
        content.append({"type": "text", "text": ""})
    return {"id": data.get("id") or "msg_" + uuid.uuid4().hex[:24], "type": "message", "role": "assistant",
            "model": model, "content": content,
            "stop_reason": STOP.get(choice.get("finish_reason"), "end_turn"), "stop_sequence": None,
            "usage": usage_of(data.get("usage"))}


def anthropic_error(status, message, etype=None):
    etype = etype or {400: "invalid_request_error", 401: "authentication_error", 403: "permission_error",
                      404: "not_found_error", 429: "rate_limit_error", 529: "overloaded_error"}.get(status, "api_error")
    return {"type": "error", "error": {"type": etype, "message": message}}


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):   # quiet default access log; we log ourselves
        pass

    def send_json(self, status, obj):
        raw = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        if self.path in ("/", "/health"):
            self.send_json(200, {"ok": True, "upstream": UPSTREAM, "model": MODEL})
        else:
            self.send_json(404, anthropic_error(404, "not found"))

    def do_POST(self):
        length = int(self.headers.get("content-length") or 0)
        try:
            req = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return self.send_json(400, anthropic_error(400, "invalid JSON"))
        path = self.path.split("?")[0].rstrip("/")
        if path.endswith("/messages/count_tokens"):
            n = len(json.dumps(req.get("messages", [])) + json.dumps(req.get("system", "")) + json.dumps(req.get("tools", []))) // 4
            return self.send_json(200, {"input_tokens": n})
        if not path.endswith("/messages"):
            return self.send_json(404, anthropic_error(404, "only /v1/messages is proxied"))
        if not UPSTREAM:
            return self.send_json(500, anthropic_error(500, "claude-proxy: COLIN_PROVIDER_URL is not set"))
        body = upstream_body(req)
        self.forward(req, body)

    def forward(self, req, body):
        data = json.dumps(body).encode()
        hreq = urllib.request.Request(UPSTREAM + "/chat/completions", data=data, method="POST", headers={
            "content-type": "application/json", "authorization": "Bearer " + KEY,
            "accept": "text/event-stream" if body["stream"] else "application/json",
            "user-agent": "colincode-claude-proxy"})
        t0 = time.time()
        try:
            resp = urllib.request.urlopen(hreq, timeout=TIMEOUT)
        except urllib.error.HTTPError as e:
            raw = e.read().decode("utf-8", "replace")
            msg = raw
            try:
                j = json.loads(raw)
                msg = (j.get("error") or {}).get("message") if isinstance(j.get("error"), dict) else j.get("message") or raw
            except ValueError:
                pass
            log("%s %d %s" % (body["model"], e.code, (msg or "")[:300]))
            return self.send_json(e.code if e.code in (400, 401, 403, 404, 413, 429, 500, 502, 503, 529) else 502,
                                  anthropic_error(e.code, "upstream %d: %s" % (e.code, msg)))
        except Exception as e:  # noqa: BLE001
            log("%s upstream error: %s" % (body["model"], e))
            return self.send_json(502, anthropic_error(502, "claude-proxy: upstream unreachable: %s" % e))
        with resp:
            if body["stream"]:
                self.stream(req, body, resp, t0)
            else:
                data = json.loads(resp.read().decode("utf-8", "replace"))
                out = convert_response(req.get("model", body["model"]), data)
                log("%s %s in %.1fs (%d/%d tok)" % (body["model"], out["stop_reason"], time.time() - t0,
                                                   out["usage"]["input_tokens"], out["usage"]["output_tokens"]))
                self.send_json(200, out)

    # Anthropic SSE from OpenAI chunks. Content block 0 is text (opened lazily),
    # each tool call gets its own block as it appears.
    def stream(self, req, body, resp, t0):
        self.send_response(200)
        self.send_header("content-type", "text/event-stream")
        self.send_header("cache-control", "no-cache")
        self.send_header("transfer-encoding", "chunked")
        self.end_headers()

        def emit(event, obj):
            payload = ("event: %s\ndata: %s\n\n" % (event, json.dumps(obj))).encode()
            self.wfile.write(("%x\r\n" % len(payload)).encode() + payload + b"\r\n")
            self.wfile.flush()

        model = req.get("model", body["model"])
        mid = "msg_" + uuid.uuid4().hex[:24]
        usage = {"input_tokens": 0, "output_tokens": 0}
        emit("message_start", {"type": "message_start", "message": {
            "id": mid, "type": "message", "role": "assistant", "model": model, "content": [],
            "stop_reason": None, "stop_sequence": None, "usage": dict(usage)}})
        next_index = 0
        text_index = None           # anthropic block index of the open text block
        calls = {}                  # openai tool index -> {"block": n, "args": str}
        finish = None
        try:
            for line in resp:
                line = line.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if payload == "[DONE]":
                    break
                try:
                    chunk = json.loads(payload)
                except ValueError:
                    continue
                if chunk.get("usage"):
                    usage = usage_of(chunk["usage"])
                for choice in chunk.get("choices") or []:
                    delta = choice.get("delta") or {}
                    if choice.get("finish_reason"):
                        finish = choice["finish_reason"]
                    if delta.get("content"):
                        if text_index is None:
                            text_index = next_index; next_index += 1
                            emit("content_block_start", {"type": "content_block_start", "index": text_index,
                                                         "content_block": {"type": "text", "text": ""}})
                        emit("content_block_delta", {"type": "content_block_delta", "index": text_index,
                                                     "delta": {"type": "text_delta", "text": delta["content"]}})
                    for tc in delta.get("tool_calls") or []:
                        i = tc.get("index", 0)
                        fn = tc.get("function") or {}
                        if i not in calls:
                            if text_index is not None:
                                emit("content_block_stop", {"type": "content_block_stop", "index": text_index})
                                text_index = None
                            calls[i] = {"block": next_index, "args": ""}; next_index += 1
                            emit("content_block_start", {"type": "content_block_start", "index": calls[i]["block"],
                                                         "content_block": {"type": "tool_use",
                                                                           "id": tc.get("id") or "call_" + uuid.uuid4().hex[:24],
                                                                           "name": fn.get("name", ""), "input": {}}})
                        if fn.get("arguments"):
                            calls[i]["args"] += fn["arguments"]
                            emit("content_block_delta", {"type": "content_block_delta", "index": calls[i]["block"],
                                                         "delta": {"type": "input_json_delta", "partial_json": fn["arguments"]}})
        except Exception as e:  # noqa: BLE001
            log("%s stream broke: %s" % (body["model"], e))
            emit("error", {"type": "error", "error": {"type": "api_error", "message": "claude-proxy: upstream stream broke: %s" % e}})
        if text_index is not None:
            emit("content_block_stop", {"type": "content_block_stop", "index": text_index})
        for c in calls.values():
            if not c["args"].strip():   # Claude Code needs valid JSON per tool_use
                emit("content_block_delta", {"type": "content_block_delta", "index": c["block"],
                                             "delta": {"type": "input_json_delta", "partial_json": "{}"}})
            emit("content_block_stop", {"type": "content_block_stop", "index": c["block"]})
        if next_index == 0:   # nothing at all: send an empty text block so the client has content
            emit("content_block_start", {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}})
            emit("content_block_stop", {"type": "content_block_stop", "index": 0})
        stop = "tool_use" if calls else STOP.get(finish, "end_turn")
        emit("message_delta", {"type": "message_delta", "delta": {"stop_reason": stop, "stop_sequence": None},
                               "usage": {"output_tokens": usage["output_tokens"], "input_tokens": usage["input_tokens"]}})
        emit("message_stop", {"type": "message_stop"})
        self.wfile.write(b"0\r\n\r\n"); self.wfile.flush()
        log("%s %s in %.1fs (%d/%d tok, %d tool call%s)" % (body["model"], stop, time.time() - t0,
            usage["input_tokens"], usage["output_tokens"], len(calls), "" if len(calls) == 1 else "s"))


if __name__ == "__main__":
    if not UPSTREAM:
        log("COLIN_PROVIDER_URL is not set — nothing to proxy to")
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    srv.daemon_threads = True
    log("claude-proxy listening on http://127.0.0.1:%d -> %s (%s)" % (PORT, UPSTREAM or "?", MODEL or "model from request"))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
PYEOF
}

# ------------------------------------------------------------ runtime wiring
#
# Everything provider-specific is an env file inside the box
# ($BOX_ENV, mode 0600) that the tmux launch sources. It is written over ssh
# stdin so secrets never appear on a command line, and rewritten on every
# `up`, so switching provider or model is just a restart of the agent.

agent_runtime_env() {   # uses A_* ; prints KEY='value' lines (sh-quoted)
  provider_spec "$A_PROVIDER"
  if [ "$P_NATIVE" = yes ]; then
    # a harness default that is still a key (Prime Intellect, TinyFish): the key alone
    if [ -n "$P_KEY_VAR" ] && [ -n "$(get_var "$P_KEY_VAR")" ]; then
      printf '%s=%s\n' "$P_KEY_VAR" "$(shq "$(get_var "$P_KEY_VAR")")"
      [ "$P_KEY_VAR" = HOTDATA_API_KEY ] && [ -n "$(get_var HOTDATA_WORKSPACE)" ] && printf 'HOTDATA_WORKSPACE=%s\n' "$(shq "$(get_var HOTDATA_WORKSPACE)")"
    fi
    return 0
  fi
  local key model small
  key=$(get_var "$P_KEY_VAR"); model=${A_MODEL:-${P_MODELS%% *}}
  [ -n "$model" ] || die "no model for $P_LABEL — set one: colin $A_NAME model <id>"
  printf 'COLIN_PROVIDER=%s\nCOLIN_MODEL=%s\nCOLIN_PROVIDER_KEY=%s\n' "$(shq "$P_NAME")" "$(shq "$model")" "$(shq "$key")"
  case "$A_HARNESS" in
    claude)
      if agent_proxied; then
        # Claude Code talks to the in-box proxy; the proxy reads COLIN_* above.
        printf 'COLIN_PROVIDER_URL=%s\nCOLIN_PROXY_PORT=%s\n' "$(shq "$P_OPENAI_URL")" "$PROXY_PORT"
        printf "ANTHROPIC_BASE_URL='http://127.0.0.1:%s'\nANTHROPIC_AUTH_TOKEN='colin-proxy'\n" "$PROXY_PORT"
      else
        printf 'ANTHROPIC_BASE_URL=%s\nANTHROPIC_AUTH_TOKEN=%s\n' "$(shq "$P_ANTHROPIC_URL")" "$(shq "$key")"
      fi
      [ "$P_NAME" = openrouter ] && printf "ANTHROPIC_API_KEY=''\n"
      printf 'ANTHROPIC_MODEL=%s\nANTHROPIC_DEFAULT_SONNET_MODEL=%s\nANTHROPIC_DEFAULT_OPUS_MODEL=%s\nANTHROPIC_DEFAULT_HAIKU_MODEL=%s\n' \
        "$(shq "$model")" "$(shq "$model")" "$(shq "$model")" "$(shq "$model")"
      printf "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT='1'\nCLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC='1'\n"
      ;;
    codex)
      printf '%s=%s\n' "$P_KEY_VAR" "$(shq "$key")"
      ;;
    copilot)
      # Copilot CLI's bring-your-own-model settings: an OpenAI-compatible /v1 and a key
      printf 'COPILOT_PROVIDER_TYPE=openai\nCOPILOT_PROVIDER_BASE_URL=%s\nCOPILOT_PROVIDER_API_KEY=%s\nCOPILOT_MODEL=%s\nCOPILOT_AUTO_UPDATE=false\n' \
        "$(shq "$P_OPENAI_URL")" "$(shq "$key")" "$(shq "$model")"
      ;;
    open-webui)
      # read at every start (persistent config off); single user behind the tunnel
      printf 'OPENAI_API_BASE_URL=%s\nOPENAI_API_KEY=%s\nDEFAULT_MODELS=%s\nENABLE_OLLAMA_API=false\nENABLE_PERSISTENT_CONFIG=false\nWEBUI_AUTH=false\nANONYMIZED_TELEMETRY=false\n' \
        "$(shq "$P_OPENAI_URL")" "$(shq "$key")" "$(shq "$model")"
      ;;
    opencode|opencode-web)
      printf '%s=%s\n' "$P_KEY_VAR" "$(shq "$key")"
      local cfg
      cfg=$(printf '{"$schema":"https://opencode.ai/config.json","model":"%s/%s"}' "$P_OPENCODE" "$model")
      printf 'OPENCODE_CONFIG_CONTENT=%s\n' "$(shq "$cfg")"
      ;;
  esac
}

# Extra CLI arguments for the harness launch (codex takes its provider on the
# command line: custom providers must use the Responses wire API).
agent_launch_args() {
  provider_spec "$A_PROVIDER"
  [ "$P_NATIVE" = yes ] && return 0
  local model=${A_MODEL:-${P_MODELS%% *}}
  case "$A_HARNESS" in
    codex)
      printf -- "-c model_provider='\"%s\"' -c model='\"%s\"' -c 'model_providers.%s.name=\"%s\"' -c 'model_providers.%s.base_url=\"%s\"' -c 'model_providers.%s.env_key=\"COLIN_PROVIDER_KEY\"' -c 'model_providers.%s.wire_api=\"responses\"'" \
        "$P_NAME" "$model" "$P_NAME" "$P_LABEL" "$P_NAME" "$P_OPENAI_URL" "$P_NAME" "$P_NAME"
      ;;
  esac
}

push_runtime_env() {   # name ; writes $BOX_ENV in the box from A_*
  local name=$1 content
  content=$(agent_runtime_env)
  [ "$H_KIND" = web ] && content="$content
COLIN_WEB_TOKEN=$(shq "$(web_token)")"
  printf '%s\n' "$content" | tenki sandbox ssh "$name" -- \
    "umask 077; mkdir -p ~/.config/colincode; cat > $BOX_ENV; printf '%s' $(shq "$A_PROVIDER:${A_MODEL:-default}") > ~/.config/colincode/agent.stamp" \
    >/dev/null 2>&1 || die "could not write the runtime env into '$name'"
  if agent_proxied; then
    claude_proxy_source | tenki sandbox ssh "$name" -- "umask 077; cat > $BOX_PROXY" >/dev/null 2>&1 \
      || die "could not write the claude proxy into '$name'"
  fi
}

# The proxy runs in its own tmux session next to the agent so it survives ssh
# drops and pauses like the agent does. Idempotent: a live proxy is kept.
start_proxy() {   # name
  local name=$1 sess="$H_NAME-proxy"
  if sb_exec "$name" "tmux has-session -t =$sess 2>/dev/null && curl -sf http://127.0.0.1:$PROXY_PORT/health >/dev/null 2>&1" >/dev/null 2>&1; then
    return 0
  fi
  sb_exec "$name" "tmux kill-session -t =$sess 2>/dev/null" >/dev/null 2>&1 || true
  info "starting the Anthropic->OpenAI proxy for claude (tmux session $sess, 127.0.0.1:$PROXY_PORT)"
  local inner="set -a; . $BOX_ENV 2>/dev/null; set +a; exec python3 -I $BOX_PROXY"
  sb_exec "$name" "cd \$HOME && tmux new-session -d -s $sess $(shq "sh -c $(shq "$inner")")" >/dev/null \
    || die "failed to start the claude proxy inside '$name'"
  sb_exec "$name" "for i in \$(seq 1 40); do curl -sf http://127.0.0.1:$PROXY_PORT/health >/dev/null 2>&1 && exit 0; sleep 0.25; done; exit 1" >/dev/null 2>&1 \
    || die "the claude proxy did not come up in '$name' — look with: colin $name shell, then tmux attach -t $sess"
}
stop_proxy() { sb_exec "$1" "tmux kill-session -t =$H_NAME-proxy 2>/dev/null" >/dev/null 2>&1 || true; }

# For the harnesses whose provider lives in their own config file, agentcamp's
# inject-provider.sh (the script its sandboxes run at boot) is fetched into the
# box and run for just this harness: base URL, key and model, merged into the
# CLI's config, the CLI's "don't ask" mode on (the box is single-tenant). Its
# provider is called "colin" in the CLI's pickers. The key reaches it from the
# runtime env file, never a local command line.
inject_provider() {   # name
  [ -n "$H_INJECT" ] || return 0
  provider_spec "$A_PROVIDER"; [ "$P_NATIVE" = yes ] && return 0
  [ -n "$P_OPENAI_URL" ] || die "$P_LABEL has no OpenAI-compatible endpoint for $H_LABEL"
  local name=$1 model=${A_MODEL:-${P_MODELS%% *}} base=${P_OPENAI_URL%/}; base=${base%/v1}
  info "pointing $H_LABEL at $P_LABEL · $model (agentcamp's inject-provider.sh, in the box)"
  sb_exec "$name" "set -e; $BOX_PATH; mkdir -p ~/.config/colincode; f=~/.config/colincode/inject-provider.sh
    if [ ! -s \"\$f\" ] || [ -n \"\$(find \"\$f\" -mmin +1440 2>/dev/null)\" ]; then curl -fsSL $(shq "$INJECT_URL") -o \"\$f.tmp\" && mv \"\$f.tmp\" \"\$f\"; fi
    sed -i 's/^NAME = \"aisa.one\"/NAME = \"colin\"/; s/^ID, OLD_ID = \"ixio\", \"relay\"/ID, OLD_ID = \"colin\", \"ixio\"/' \"\$f\"
    set -a; . $BOX_ENV; set +a; cd $(agent_cwd)
    bash \"\$f\" --base $(shq "$base") --key \"\$COLIN_PROVIDER_KEY\" --harness $H_INJECT --$H_INJECT-model $(shq "$model") --workdir \"\$PWD\"" >/dev/null \
    || die "could not configure $H_LABEL for $P_LABEL in '$name' (look with: colin $A_NAME shell)"
}

# A token for web UIs that take one (OpenClaw), made once per agent, kept locally.
web_token() {
  local f="$AGENTS_DIR/.tokens/$A_NAME"
  if [ ! -s "$f" ]; then
    mkdir -p "$AGENTS_DIR/.tokens"; chmod 700 "$AGENTS_DIR/.tokens"
    (umask 077; LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 32 > "$f")
  fi
  cat "$f"
}
web_url_suffix() { case "$H_NAME" in openclaw-web) printf '?token=%s' "$(web_token)" ;; esac; }
open_url() { if command -v open >/dev/null 2>&1; then open "$1"; elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1; fi; }
free_local_port() {   # from -> first free local port at or above it
  local p=$1
  while (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; do p=$((p+1)); done
  printf '%s' "$p"
}

# Web UIs are not exposed to the internet by default: the box port is forwarded
# over ssh to localhost here and the browser opened on it. Ctrl-C drops the
# tunnel; the UI keeps running in the box (tmux session named after the harness).
web_open() {   # name
  local name=$1 port=$H_PORT lport url pid i
  info "waiting for $H_LABEL to answer on port $port in '$name' (a first start can take a minute or two)"
  sb_exec "$name" "for i in \$(seq 1 240); do curl -s -o /dev/null http://127.0.0.1:$port/ && exit 0; sleep 1; done; exit 1" >/dev/null 2>&1 \
    || die "$H_LABEL did not come up in '$name' — look with: colin $name shell, then tmux attach -t $H_NAME"
  lport=$(free_local_port "$port")
  url="http://localhost:$lport/$(web_url_suffix)"
  if ! tty_ok; then
    printf '%s\n' "$url"
    info "tunnel it yourself: tenki sandbox ssh $name -- -N -L $lport:127.0.0.1:$port"; return 0
  fi
  tenki sandbox ssh "$name" -- -N -L "$lport:127.0.0.1:$port" &
  pid=$!
  trap 'kill $pid 2>/dev/null' INT TERM EXIT
  for i in $(seq 1 40); do curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$lport/" && break; sleep 0.5; done
  printf '\n    %s        : %s\n    public link : colin %s url   (no tunnel needed; anyone with the link gets in)\n    pause       : colin %s down\n    tunnel      : Ctrl-C closes it; %s keeps running in the box\n\n' "$H_LABEL" "$url" "$name" "$name" "$H_LABEL" >&2
  open_url "$url"
  wait $pid
}

# The provider/model the running agent was started with, from the box.
box_stamp() { sb_exec "$1" 'cat ~/.config/colincode/agent.stamp 2>/dev/null' 2>/dev/null | grep -v -E '^(status|exit_code|duration|reason)' | head -n1 || true; }

start_agent() {   # name
  local name=$1 want="$A_PROVIDER:${A_MODEL:-default}"
  if sb_exec "$name" "tmux has-session -t =$H_NAME 2>/dev/null" >/dev/null 2>&1; then
    if [ "$(box_stamp "$name")" = "$want" ]; then
      ! agent_proxied || start_proxy "$name"   # bring the proxy back if it died
      info "$H_NAME is already running in '$name'"
      return 0
    fi
    info "provider or model changed — restarting $H_NAME"
    sb_exec "$name" "tmux kill-session -t =$H_NAME 2>/dev/null" >/dev/null 2>&1 || true
    stop_proxy "$name"
  fi
  push_runtime_env "$name"
  inject_provider "$name"
  if agent_proxied; then start_proxy "$name"; else stop_proxy "$name"; fi
  [ "$H_NAME" = claude ] && seed_claude_config "$name"
  [ "$H_NAME" = codex ]  && seed_codex_trust "$name"
  provider_spec "$A_PROVIDER"
  info "starting $H_LABEL in '$name' ($P_LABEL${A_MODEL:+ · $A_MODEL}$(agent_proxied && printf ' · via proxy'))"
  local launch=$H_LAUNCH args; args=$(agent_launch_args)
  [ "$A_PROVIDER" = "$H_NATIVE" ] && launch="$launch$H_LAUNCH_NATIVE"
  launch=${launch//\{BOX\}/$name}
  case "$launch$args" in *"'"*) : ;; esac
  # sh sources the env file (set -a exports it), then execs the harness.
  # sh: ~/.local/bin on PATH (uv, goose, omp, droid, adal live there), the env file
  # (set -a exports it) and the injector's env, then exec the harness.
  local inner="$BOX_PATH; set -a; . $BOX_ENV 2>/dev/null; [ -f ./.agent-provider.env ] && . ./.agent-provider.env; set +a; exec $launch $args"
  sb_exec "$name" "cd $(agent_cwd) && tmux new-session -d -s $H_NAME $(shq "sh -c $(shq "$inner")")" >/dev/null \
    || die "failed to start $H_NAME inside '$name'"
}

attach() {
  local name=$1; shift
  info "attaching to '$name' (detach with Ctrl-b d — the agent keeps running)"
  tenki sandbox ssh "$name" -- -t "tmux attach -t =$H_NAME || exec \$SHELL -l" "$@"
}

# ----------------------------------------------------------------- pickers

pick_agent_or_new() {   # sets PICK=agent-name or PICK=new
  local items=() names=() n st
  for n in $(agent_names); do
    agent_load "$n"; st=$(state_of "$n" | tr 'A-Z' 'a-z')
    names+=("$n")
    items+=("$(printf '%-20s %-13s %-11s %-30s %-7s %s' "$n" "$A_HARNESS" "$A_PROVIDER" "$(short "${A_MODEL:-default}" 30)" "$(size_short "$A_CPU" "$A_MEM")$([ "$A_VOLUME_GB" -gt 0 ] && printf '+%sg' "$A_VOLUME_GB")" "$st")")
  done
  if [ ${#names[@]} -eq 0 ]; then PICK=new; return 0; fi
  items+=("$(printf '%-20s %s' "+ new agent" "pick a harness, provider, model, size, volume and name")")
  menu "Which agent?" 0 "${items[@]}"
  if [ "$MENU_INDEX" -lt ${#names[@]} ]; then PICK=${names[$MENU_INDEX]}; else PICK=new; fi
}

pick_kind() {   # -> PICK=cli|web
  menu "Terminal or web?" 0 \
    "cli      a terminal agent in tmux — you attach over ssh, it survives disconnects" \
    "web      a web UI served from the box — tunnelled to your browser on localhost"
  PICK=$MENU_VALUE
}

pick_harness() {   # [cli|web] -> PICK=harness
  local kind=${1:-} h list items=() values=()
  if [ -z "$kind" ]; then pick_kind; kind=$PICK; fi
  list=$CLI_HARNESSES; [ "$kind" = web ] && list=$WEB_HARNESSES
  for h in $list; do
    harness_spec "$h"
    items+=("$(printf '%-13s %s%s' "$h" "$H_LABEL" "${H_NOTE:+ — $H_NOTE}")"); values+=("$h")
  done
  menu "Which harness?" 0 "${items[@]}"
  PICK=${values[$MENU_INDEX]}
}

pick_provider() {   # harness -> PICK=provider
  local h=$1 p items=() values=() why label
  harness_spec "$h"
  for p in $H_NATIVE nebius boundless baseten friendli openrouter; do
    provider_spec "$p"
    why=$(provider_blocker "$h" "$p")
    if [ -n "$why" ]; then label=$(printf '%-12s %s (unavailable: %s)' "$p" "$P_LABEL" "$why")
    elif [ "$P_NATIVE" = yes ]; then label=$(printf '%-12s %s — %s' "$p" "$P_LABEL" "$P_NOTE")
    else
      label=$(printf '%-12s %s · %s' "$p" "$P_LABEL" "${P_MODELS%% *}")
      if [ "$h" = claude ] && [ -z "$P_ANTHROPIC_URL" ]; then label="$label (via proxy, no Remote Control)"
      elif [ "$h" = claude ]; then label="$label (no Remote Control)"; fi
      [ -n "$P_NOTE" ] && label="$label — $P_NOTE"
    fi
    items+=("$label"); values+=("$p")
  done
  while :; do
    menu "Inference provider for $h" 0 "${items[@]}"
    PICK=${values[$MENU_INDEX]}
    why=$(provider_blocker "$h" "$PICK")
    [ -z "$why" ] && return 0
    warn "$PICK: $why"
  done
}

# Every model the provider serves (GET /v1/models, cached for an hour), with
# the recommended ones first. Falls back to the built-in list offline.
provider_models() {   # provider -> lines
  provider_spec "$1"
  local key cache list m
  key=$(get_var "$P_KEY_VAR")
  mkdir -p "$CONFIG_DIR/cache" 2>/dev/null || true
  cache="$CONFIG_DIR/cache/$P_NAME.models"
  if [ -n "$key" ] && [ -n "$P_OPENAI_URL" ] && { [ ! -s "$cache" ] || [ -n "$(find "$cache" -mmin +60 2>/dev/null)" ]; }; then
    list=$(curl -fsS -m 15 -H "Authorization: Bearer $key" "$P_OPENAI_URL/models" 2>/dev/null \
           | jq -r '.data[]?.id // empty' 2>/dev/null | sort -f) || list=""
    [ -n "$list" ] && printf '%s\n' "$list" > "$cache"
  fi
  for m in $P_MODELS; do printf '%s\n' "$m"; done
  if [ -s "$cache" ]; then
    grep -vxF -f <(printf '%s\n' $P_MODELS) "$cache" || true
  fi
}

pick_model() {   # provider -> PICK=model id ('' for native/default)
  provider_spec "$1"
  PICK=""
  [ "$P_NATIVE" = yes ] && return 0
  local m items=() values=() i=0 nrec
  nrec=$(printf '%s\n' $P_MODELS | grep -c .)
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    if [ "$i" -lt "$nrec" ]; then items+=("$(printf '%-44s recommended%s' "$m" "$([ "$i" = 0 ] && printf ' · default')")")
    else items+=("$m"); fi
    values+=("$m"); i=$((i+1))
  done < <(provider_models "$1")
  items+=("other…     type a model id"); values+=("__other")
  menu "Model on $P_LABEL" 0 "${items[@]}"
  PICK=${values[$MENU_INDEX]}
  if [ "$PICK" = __other ]; then
    printf '  \033[1mModel id\033[0m\n  > ' >&2; IFS= read -r PICK </dev/tty
    [ -n "$PICK" ] || die "no model given"
  fi
}

pick_size() {   # [cpu mem] -> PICK_CPU PICK_MEM
  local cur_cpu=${1:-} cur_mem=${2:-} items=() n def=1 i=0 tag="(current)"
  [ -n "$cur_cpu" ] || { default_size; cur_cpu=$DEF_CPU; cur_mem=$DEF_MEM; tag="(default)"; }
  for n in $SIZES; do
    size_spec "$n"
    items+=("$(printf '%-9s %-18s %s' "$n" "$(size_label "$S_CPU" "$S_MEM")" "$([ "$S_CPU" = "$cur_cpu" ] && [ "$S_MEM" = "$cur_mem" ] && printf '%s' "$tag")")")
    [ "$S_CPU" = "$cur_cpu" ] && [ "$S_MEM" = "$cur_mem" ] && def=$i
    i=$((i+1))
  done
  menu "Box size" "$def" "${items[@]}"
  size_spec "$MENU_VALUE"; PICK_CPU=$S_CPU; PICK_MEM=$S_MEM
}

pick_volume() {   # [current_gb] -> PICK_VOLUME_GB (0 = none)
  local cur=${1:-$VOLUME_GB_DEFAULT} items=() g def=0 i=0
  for g in $VOLUME_SIZES; do
    items+=("$(printf '%-6s %-8s %s' "$g" "${g} GiB" "mounted at ~/work · survives pause and rm")")
    [ "$g" = "$cur" ] && def=$i
    i=$((i+1))
  done
  items+=("$(printf '%-6s %-8s %s' none "-" "root disk only (wiped by rm)")")
  [ "$cur" = 0 ] && def=$i
  menu "Persistent volume" "$def" "${items[@]}"
  [ "$MENU_VALUE" = none ] && PICK_VOLUME_GB=0 || PICK_VOLUME_GB=$MENU_VALUE
}

pick_name() {   # default -> PICK=name
  local def=$1 n
  printf '  \033[1mAgent name\033[0m\n  \033[2m> optional, leave empty for %s\033[0m\r  > ' "$def" >&2
  IFS= read -r n </dev/tty; printf '\033[K' >&2
  n=$(slug "${n:-$def}")
  valid_name "$n" || die "bad name '$n' (lowercase letters, digits, dashes)"
  agent_exists "$n" && die "an agent named '$n' already exists"
  [ "$(state_of "$n")" = MISSING ] || die "a sandbox named '$n' already exists"
  PICK=$n
}

# Full creation flow. $1 optionally presets the harness. Sets A_*.
new_agent() {
  tty_ok || die "creating an agent is interactive — run: colin new"
  local h=${1:-} p m
  case "$h" in ""|cli|web) pick_harness "$h"; h=$PICK ;; esac
  is_harness "$h" || die "unknown harness '$h' (known: $HARNESSES)"
  harness_spec "$h"
  if [ -n "$H_NO_CUSTOM" ]; then p=$H_NATIVE; info "$H_LABEL uses its own sign-in — $H_NO_CUSTOM"
  else pick_provider "$h"; p=$PICK; fi
  ensure_provider_key "$p"
  pick_model "$p"; m=$PICK
  pick_size
  pick_volume
  pick_name "$(auto_name "$p" "$h")"
  local kept="" kept_gb
  if [ -f "$AGENTS_DIR/.volumes/$PICK" ] && [ "$PICK_VOLUME_GB" -gt 0 ]; then
    kept=$(sed -n 's/^VOLUME=//p' "$AGENTS_DIR/.volumes/$PICK"); kept_gb=$(sed -n 's/^VOLUME_GB=//p' "$AGENTS_DIR/.volumes/$PICK")
    if [ "$(volume_state "$kept")" = AVAILABLE ]; then info "reusing the kept ${kept_gb} GiB volume of a previous '$PICK'"; PICK_VOLUME_GB=$kept_gb; else kept=""; fi
    rm -f "$AGENTS_DIR/.volumes/$PICK"
  fi
  agent_save "$PICK" "$h" "$p" "$m" "$PICK_CPU" "$PICK_MEM" "$kept" "$PICK_VOLUME_GB"
  info "created agent '$PICK' ($h on $p${m:+ · $m} · $(size_label "$PICK_CPU" "$PICK_MEM")$([ "$PICK_VOLUME_GB" -gt 0 ] && printf ' · %s GiB volume' "$PICK_VOLUME_GB"))"
  agent_load "$PICK"
}

# Resolve `colin <word>` to an agent: a name, or a harness with 0/1/many agents.
resolve_agent() {   # word -> loads A_* (may create)
  local w=$1 list
  if agent_exists "$w"; then agent_load "$w"; return 0; fi
  if is_harness "$w"; then
    list=$(agents_for_harness "$w")
    case "$(printf '%s\n' "$list" | grep -c .)" in
      0) new_agent "$w" ;;
      1) agent_load "$list" ;;
      *) tty_ok || die "several $w agents exist — name one: $(printf '%s' "$list" | tr '\n' ' ')"
         local items=() n
         for n in $list; do agent_load "$n"; items+=("$(printf '%-20s %-11s %-30s %s' "$n" "$A_PROVIDER" "$(short "${A_MODEL:-default}" 30)" "$(state_of "$n" | tr 'A-Z' 'a-z')")"); done
         menu "Which $w agent?" 0 "${items[@]}"; agent_load "$MENU_VALUE" ;;
    esac
    return 0
  fi
  die "no agent or harness named '$w' (colin ls)"
}

# ---------------------------------------------------------------- subcommands

do_up() {
  local name=$A_NAME
  ensure_running "$name" "$A_HARNESS" "$A_PROVIDER"; provision "$name"
  if [ -n "$H_LOGIN" ] && [ "$A_PROVIDER" = "$H_NATIVE" ] && ! box_logged_in "$name"; then
    tty_ok || die "$H_NAME is not signed in inside '$name' — run: colin $name auth"
    box_login "$name"
    sb_exec "$name" "tmux kill-session -t =$H_NAME 2>/dev/null" >/dev/null 2>&1 || true
  fi
  [ "$A_PROVIDER" = "$H_NATIVE" ] || ensure_provider_key "$A_PROVIDER"
  start_agent "$name"
  printf '\n' >&2
  if [ "$H_KIND" = web ]; then info "'$name' is serving $H_LABEL"; web_open "$name"; return 0; fi
  info "'$name' is running $H_LABEL"
  if [ "$H_REMOTE" = yes ] && [ "$A_PROVIDER" = "$H_NATIVE" ]; then
    printf '    phone / web : https://claude.ai/code  →  "%s"\n' "$name" >&2
  fi
  printf '    pause       : colin %s down\n\n' "$name" >&2
  if tty_ok; then attach "$name"; else printf '    terminal    : colin %s\n\n' "$name" >&2; fi
}

do_shell() { ensure_running "$A_NAME" "$A_HARNESS" "$A_PROVIDER"; tenki sandbox ssh "$A_NAME" "$@"; }

# Where the agent works: the persistent volume when the agent has one, else $HOME.
agent_cwd() { if [ -n "${A_VOLUME:-}" ]; then printf '%s' "$WORK_DIR"; else printf '$HOME'; fi; }   # expanded in the box

do_run() {
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: colin $A_NAME run -- <prompt>"
  [ "$H_KIND" = web ] && die "'$A_NAME' is a web UI ($H_LABEL) — open it with: colin $A_NAME"
  [ -n "$H_RUN" ] || die "no headless mode is wired for $H_LABEL yet — use it interactively: colin $A_NAME"
  ensure_running "$A_NAME" "$A_HARNESS" "$A_PROVIDER"; provision "$A_NAME"; push_runtime_env "$A_NAME"; inject_provider "$A_NAME"
  ! agent_proxied || start_proxy "$A_NAME"
  local args; args=$(agent_launch_args)
  if [ "$H_RAWARGS" = yes ]; then   # the words are the command's own arguments (tinyfish fetch content get URL)
    tenki sandbox exec --session "$A_NAME" -- sh -c "$BOX_PATH; cd $(agent_cwd); set -a; . $BOX_ENV 2>/dev/null; set +a; exec $H_RUN \"\$@\"" _ "$@"
    return
  fi
  tenki sandbox exec --session "$A_NAME" -- sh -c "$BOX_PATH; cd $(agent_cwd); set -a; . $BOX_ENV 2>/dev/null; [ -f ./.agent-provider.env ] && . ./.agent-provider.env; set +a; exec $H_RUN $args \"\$@\"" _ "$*"
}

# A public link to a web UI: a tenki preview URL bound to the box port. Sticky
# and unauthenticated by tenki — only OpenClaw asks for a token — so it is opt-in.
do_url() {   # [off]
  [ "$H_KIND" = web ] || die "'$A_NAME' is a terminal agent ($H_LABEL); nothing to link to"
  local id slug out url
  slug="colin-$(printf '%s' "$A_NAME" | cut -c1-40)-$H_PORT"
  if [ "${1:-}" = off ]; then
    id=$(tenki sandbox preview-url list --json 2>/dev/null | jq -r --arg s "$slug" '(.preview_urls // .)[] | select(.slug==$s) | .id // .preview_url_id' | head -1)
    [ -n "$id" ] || { info "'$A_NAME' has no public link"; return 0; }
    tenki sandbox preview-url delete "$id" >/dev/null && info "removed the public link of '$A_NAME'"; return 0
  fi
  ensure_running "$A_NAME" "$A_HARNESS" "$A_PROVIDER"
  url=$(tenki sandbox preview-url list --json 2>/dev/null | jq -r --arg s "$slug" '(.preview_urls // .)[] | select(.slug==$s) | .preview_url // .url' | head -1)
  if [ -z "$url" ]; then
    id=$(tenki sandbox get "$A_NAME" --json | jq -r .id)
    out=$(tenki sandbox preview-url create --slug "$slug" --session "$id" --port "$H_PORT" --json 2>&1) || die "could not create the preview URL: $(printf '%s' "$out" | tail -1)"
    url=$(printf '%s' "$out" | jq -r '.preview_url // .url // empty')
  fi
  [ -n "$url" ] || die "tenki returned no preview URL"
  warn "public: anyone with this link reaches $H_LABEL in '$A_NAME' (remove it: colin $A_NAME url off)"
  printf '%s/%s\n' "${url%/}" "$(web_url_suffix)"
}

do_down() {
  local st; st=$(state_of "$A_NAME")
  case "$st" in
    PAUSED)  info "'$A_NAME' is already paused" ;;
    MISSING) die "no sandbox named '$A_NAME'" ;;
    *) tenki sandbox pause "$A_NAME" >/dev/null && info "paused '$A_NAME'" ;;
  esac
}

do_rm() {   # [--purge]  terminate the box; the volume is kept unless --purge
  local purge=no; [ "${1:-}" = "--purge" ] && purge=yes
  if [ "$(state_of "$A_NAME")" != MISSING ]; then
    tenki sandbox terminate "$A_NAME" >/dev/null && info "terminated sandbox '$A_NAME'"
  fi
  if [ -n "$A_VOLUME" ] && [ "$(volume_state "$A_VOLUME")" != MISSING ]; then
    if [ "$purge" = yes ]; then
      wait_volume_available "$A_VOLUME" || warn "the volume is still releasing"
      tenki sandbox volume delete "$A_VOLUME" >/dev/null && info "deleted volume $A_VOLUME (${A_VOLUME_GB} GiB)" \
        || warn "could not delete it yet — tenki sandbox volume delete $A_VOLUME"
    else
      info "kept volume $A_VOLUME (${A_VOLUME_GB} GiB, ~/work) — reattached if you recreate '$A_NAME'"
      info "delete it with: tenki sandbox volume delete $A_VOLUME"
      mkdir -p "$AGENTS_DIR/.volumes"; printf 'VOLUME=%s\nVOLUME_GB=%s\n' "$A_VOLUME" "$A_VOLUME_GB" > "$AGENTS_DIR/.volumes/$A_NAME"
    fi
  fi
  rm -f "$(agent_file "$A_NAME")" && info "removed agent '$A_NAME'"
}

do_status() {
  local st agent=no creds
  st=$(state_of "$A_NAME")
  if [ "$st" = RUNNING ] && sb_exec "$A_NAME" "tmux has-session -t =$H_NAME 2>/dev/null" >/dev/null 2>&1; then agent=yes; fi
  provider_spec "$A_PROVIDER"
  if [ -n "$H_LOGIN" ] && [ "$P_NATIVE" = yes ]; then
    if [ "$st" != RUNNING ]; then creds="unknown (box not running)"
    elif box_logged_in "$A_NAME"; then creds="signed in (claude auth login, in the box)"
    else creds="not signed in (run: colin $A_NAME auth)"; fi
  elif [ -n "$P_KEY_VAR" ]; then
    if [ -n "$(get_var "$P_KEY_VAR")" ]; then creds="$P_KEY_VAR (stored)"
    elif [ "$P_KEY_OPTIONAL" = yes ]; then creds="no $P_KEY_VAR — signs in inside the box (or: colin $A_NAME auth)"
    else creds="$P_KEY_VAR missing (colin $A_NAME auth)"; fi
  else
    creds=$(harness_env | cut -d= -f1 | tr '\n' ' '); creds=${creds:-"sign in inside the box"}
  fi
  local vol="none (root disk only)"
  if [ "$A_VOLUME_GB" -gt 0 ]; then
    [ -n "$A_VOLUME" ] && vol="${A_VOLUME_GB} GiB at $WORK_DIR ($(volume_state "$A_VOLUME" | tr 'A-Z_' 'a-z '), $A_VOLUME)" || vol="${A_VOLUME_GB} GiB (created with the box)"
  fi
  local life="-"
  if [ "$st" != MISSING ]; then
    if [ "$(tenki sandbox get "$A_NAME" --json 2>/dev/null | jq -r '.sticky')" = true ]; then
      life="sticky — never pauses by itself (recreate for auto-pause: colin $A_NAME rm, then colin $A_NAME)"
    else life="pauses $MAX_DURATION after each create or resume (colin resumes it); kept $PAUSE_RETENTION while paused"; fi
  fi
  printf 'agent     %s\nharness   %s\nprovider  %s\nmodel     %s\nsize      %s\nvolume    %s\nbox       %s\nstate     %s\nlifetime  %s\nrunning   %s\ncreds     %s\n' \
    "$A_NAME" "$A_HARNESS" "$A_PROVIDER" "${A_MODEL:-default}" "$(size_label "$A_CPU" "$A_MEM")" "$vol" "$A_NAME" "$st" "$life" "$agent" "$creds"
  [ "$H_KIND" = web ] && printf 'ui        http://localhost:%s/ through: colin %s   (public link: colin %s url)\n' "$H_PORT" "$A_NAME" "$A_NAME"
  if agent_proxied; then
    local px=no
    [ "$st" = RUNNING ] && sb_exec "$A_NAME" "curl -sf http://127.0.0.1:$PROXY_PORT/health >/dev/null 2>&1" >/dev/null 2>&1 && px=yes
    printf 'proxy     %s (Anthropic->OpenAI translator, tmux session %s-proxy)\n' "$px" "$H_NAME"
  fi
}

do_provider() {   # change provider (and model) for an existing agent
  tty_ok || die "picking a provider is interactive"
  pick_provider "$A_HARNESS"; local p=$PICK
  ensure_provider_key "$p"
  pick_model "$p"
  A_PROVIDER=$p; A_MODEL=$PICK; agent_resave
  info "'$A_NAME' now uses $p${PICK:+ · $PICK} — it restarts on the next: colin $A_NAME"
}

do_model() {
  local m=${1:-}
  if [ -z "$m" ]; then tty_ok || die "usage: colin $A_NAME model <id>"; pick_model "$A_PROVIDER"; m=$PICK; fi
  A_MODEL=$m; agent_resave
  info "'$A_NAME' now uses model ${m:-default} — it restarts on the next: colin $A_NAME"
}

do_size() {   # [name] — change the box size; applies when the box is (re)created
  local n=${1:-}
  if [ -z "$n" ]; then
    tty_ok || die "usage: colin $A_NAME size <$(printf '%s' "$SIZES" | tr ' ' '|')>"
    pick_size "$A_CPU" "$A_MEM"
  else
    is_size "$n" || die "unknown size '$n' (one of: $SIZES)"
    size_spec "$n"; PICK_CPU=$S_CPU; PICK_MEM=$S_MEM
  fi
  [ "$PICK_CPU" = "$A_CPU" ] && [ "$PICK_MEM" = "$A_MEM" ] && { info "'$A_NAME' is already $(size_label "$A_CPU" "$A_MEM")"; return 0; }
  local old; old=$(size_label "$A_CPU" "$A_MEM")
  A_CPU=$PICK_CPU; A_MEM=$PICK_MEM; agent_resave
  info "'$A_NAME' is now $(size_label "$A_CPU" "$A_MEM")"
  if [ "$(state_of "$A_NAME")" != MISSING ]; then
    warn "tenki boxes can't be resized in place — the existing box keeps $old"
    warn "to apply it: colin $A_NAME rm (keeps the volume, loses the root disk and logins), then colin $A_NAME"
  fi
}

do_volume() {   # [GiB|none] — add or drop the agent's persistent volume
  local g=${1:-} st
  if [ -z "$g" ]; then tty_ok || die "usage: colin $A_NAME volume <GiB|none>"; pick_volume "$A_VOLUME_GB"; g=$PICK_VOLUME_GB; fi
  [ "$g" = none ] && g=0
  printf '%s' "$g" | grep -Eq '^[0-9]+$' || die "volume size must be a number of GiB, or none"
  st=$(volume_state "$A_VOLUME")
  if [ "$g" = 0 ]; then
    [ "$A_VOLUME_GB" = 0 ] && { info "'$A_NAME' has no volume"; return 0; }
    if [ "$st" != MISSING ]; then
      if [ "$st" = IN_USE ]; then
        sb_exec "$A_NAME" "tmux kill-session -t =$H_NAME 2>/dev/null; sync" >/dev/null 2>&1 || true
        tenki sandbox volume detach "$A_NAME" "$A_VOLUME" >/dev/null || die "could not detach the volume from '$A_NAME'"
        wait_volume_available "$A_VOLUME" || die "the volume is still attached — try again in a moment"
      fi
      tenki sandbox volume delete "$A_VOLUME" >/dev/null && info "deleted volume $A_VOLUME (${A_VOLUME_GB} GiB)"
    fi
    A_VOLUME=""; A_VOLUME_GB=0; agent_resave
    info "'$A_NAME' now works on its root disk; restart with: colin $A_NAME"
    return 0
  fi
  if [ "$st" = MISSING ]; then
    A_VOLUME=""; A_VOLUME_GB=$g; ensure_volume
    if [ "$(state_of "$A_NAME")" = RUNNING ]; then
      tenki sandbox volume attach "$A_NAME" "$A_VOLUME" --mount "$WORK_DIR" >/dev/null && info "attached at $WORK_DIR"
      sb_exec "$A_NAME" "tmux kill-session -t =$H_NAME 2>/dev/null" >/dev/null 2>&1 || true
      info "the agent restarts in $WORK_DIR on the next: colin $A_NAME"
    else
      info "it is attached when the box is next created or resumed"
    fi
    return 0
  fi
  info "'$A_NAME' already has a ${A_VOLUME_GB} GiB volume"
  info "tenki volumes keep their size once attached — for ${g} GiB: colin $A_NAME volume none (deletes it and its data), then colin $A_NAME volume $g"
}

do_auth() {
  provider_spec "$A_PROVIDER"
  if [ "$P_NATIVE" = yes ] && [ -n "$H_LOGIN" ]; then
    ensure_running "$A_NAME" "$A_HARNESS" "$A_PROVIDER"; provision "$A_NAME"; box_login "$A_NAME"
  elif [ "$P_NATIVE" = yes ]; then
    info "$H_LABEL signs in or is configured inside the box: colin $A_NAME shell, then run $H_CMD"
    [ -n "$H_VARS" ] && info "(or store $H_VARS in $ENV_FILE before creating the box)"
  else
    tty_ok || die "storing a key is interactive"
    info "$P_LABEL key — create one at $P_KEYS_URL"
    prompt_secret "$P_KEY_VAR" || die "nothing stored"
  fi
}

# colin pause --all / colin rm --all: every agent colin knows about.
cmd_all() {   # down|rm [--purge]
  local names n
  names=$(agent_names)
  [ -n "$names" ] || { info "no agents — nothing to $1"; return 0; }
  for n in $names; do
    agent_load "$n"
    case "$1" in down) do_down ;; rm) do_rm "${2:-}" ;; esac
  done
}

cmd_ls() {
  migrate_legacy_boxes
  local n; local names; names=$(agent_names)
  [ -n "$names" ] || { info "no agents yet — run: colin"; return 0; }
  printf '%-22s %-13s %-12s %-28s %-8s %-6s %s\n' AGENT HARNESS PROVIDER MODEL SIZE VOL STATE
  for n in $names; do
    agent_load "$n"
    printf '%-22s %-13s %-12s %-28s %-8s %-6s %s\n' "$n" "$A_HARNESS" "$A_PROVIDER" "${A_MODEL:-default}" "$(size_short "$A_CPU" "$A_MEM")" "$([ "$A_VOLUME_GB" -gt 0 ] && printf '%sg' "$A_VOLUME_GB" || printf -- -)" "$(state_of "$n")"
  done
}

usage() {
  cat <<USAGE
colincode — a coding agent in a tenki.cloud box, one command away.

  colin                        pick an agent (or create one) and jump into it
  colin new [cli|web|harness]  create an agent: terminal or web → harness → provider → model → size → volume → name
  colin <harness> [action]     a harness (below) — your agent for it, or a new one
  colin <agent> [action]       a specific agent by name

Harnesses (terminal, in tmux): $CLI_HARNESSES
Web UIs (served from the box, tunnelled to localhost): $WEB_HARNESSES

Actions:
  up        (default)  create or resume the box, start the agent, attach
  ssh                  same as up (attach to the running agent)
  shell                plain shell in the box
  run -- <prompt>      one-shot headless prompt
  status               agent, provider, box state
  provider             switch inference provider (and model)
  model [id]           switch model
  size [name]          box size ($SIZES); applies when the box is created
  volume [GiB|none]    persistent volume at ~/work: add one, or drop it
  url [off]            web UIs: a public tenki preview link (anyone with it gets in), or remove it
  auth                 sign in / store the provider key
  down | pause         pause the box (auto-resumed next time)
  rm | stop | kill     terminate the box and forget the agent (--purge also deletes the volume)

  colin ls                     list agents and their boxes
  colin pause --all            pause every agent's box
  colin rm --all [--purge]     terminate every box and forget every agent
                               (stop / kill / terminate work the same; --purge deletes volumes)

Providers: $PROVIDERS
  Each harness also offers its own default: a sign-in or in-app setup inside the
  box (Anthropic for Claude Code, OpenAI for Codex, GitHub for Copilot, Google for
  Gemini, Qwen, Moonshot for Kimi, Factory for Droid; crush/goose/pi/omp/hermes/
  openclaw/Open WebUI are configured inside). Gemini CLI and AdaL take only their
  own. For the rest, a third-party provider is written into the harness's own
  config by agentcamp's inject-provider.sh, which also puts that harness in its
  no-approval mode (the box is yours alone). The other providers are
  OpenAI-compatible; Boundless, Baseten, Friendli and OpenRouter also speak the
  Anthropic API so Claude Code can use them directly. Nebius has no Anthropic
  API, so for Claude Code colin runs a small translation proxy inside the box
  (tmux session claude-proxy). Any third-party provider costs Claude Code its
  Remote Control.

Examples:
  colin                        menu
  colin claude                 your Claude Code agent (creates one if none)
  colin new codex              a Codex agent on, say, Nebius → "nebius-codex"
  colin nebius-codex run -- "fix the failing test"

Sizes: small 2 vCPU/4 GiB · medium 4/8 (default) · large 8/16 · xlarge 12/32 · xxlarge 16/64
Volume: each agent can have a persistent volume (10/25/50 GiB; workspaces cap the size) at ~/work. The
  agent starts there; it survives pause, rm and box resizing. The root disk does
  not. A volume keeps its size for life (tenki), so pick generously.

Env: COLINCODE_HARNESS, COLINCODE_SIZE, COLINCODE_CPU, COLINCODE_MEMORY_MB, COLINCODE_DISK_GB,
     COLINCODE_VOLUME_GB (10), COLINCODE_IMAGE, COLINCODE_STICKY (0: boxes pause by themselves),
     COLINCODE_MAX_DURATION (2h, the tenki cap), COLINCODE_PAUSE_RETENTION (720h),
     COLINCODE_PROXY_PORT (8787)
USAGE
}

main() {
  need tenki; need jq
  local action

  if [ $# -eq 0 ]; then
    tty_ok || { usage; return 0; }
    migrate_legacy_boxes
    pick_agent_or_new
    if [ "$PICK" = new ]; then new_agent; else agent_load "$PICK"; fi
    do_up; return 0
  fi

  case "$1" in
    help|-h|--help) usage; return 0 ;;
    ls|list)        cmd_ls; return 0 ;;
    down|pause|rm|stop|kill|terminate)
      case "${2:-}" in --all|-a|all)
        migrate_legacy_boxes
        case "$1" in down|pause) cmd_all down ;; *) cmd_all rm "${3:-}" ;; esac
        return 0 ;;
      esac ;;
    new|create)     shift; migrate_legacy_boxes; new_agent "${1:-}"; do_up; return 0 ;;
    auth)           shift; migrate_legacy_boxes; resolve_agent "${1:-$DEFAULT_HARNESS}"; do_auth; return 0 ;;
  esac

  migrate_legacy_boxes
  if agent_exists "$1" || is_harness "$1"; then
    resolve_agent "$1"; shift
  else
    resolve_agent "$DEFAULT_HARNESS"
  fi
  action=${1:-up}; [ $# -gt 0 ] && shift

  case "$action" in
    up)            do_up ;;
    ssh|attach)    do_up "$@" ;;
    shell)         do_shell "$@" ;;
    run)           do_run "$@" ;;
    status)        do_status ;;
    provider)      do_provider ;;
    model)         do_model "${1:-}" ;;
    size)          do_size "${1:-}" ;;
    volume)        do_volume "${1:-}" ;;
    url|link)      do_url "${1:-}" ;;
    auth|login)    do_auth ;;
    down|pause)    do_down ;;
    rm|terminate|stop|kill) do_rm "${1:-}" ;;
    *) die "unknown action '$action' (see: colin help)" ;;
  esac
}

main "$@"
